import{writeFileSync}from'node:fs';
import{content}from'/tmp/build-diary-03-lab/src/content/index';import{createBattle,resolveRound,advanceReplay,usePotion,useBattleBloom,useBattleFairy}from'/tmp/build-diary-03-lab/src/domain/engine';import{gem,valid}from'/tmp/build-diary-03-lab/scripts/diary-part3/core';import{RECEIPT}from'/tmp/build-diary-03-lab/src/domain/research-ione';import{partyOrderOptions}from'/tmp/build-diary-03-lab/src/domain/party-orders';import{validateCommandOrder}from'/tmp/build-diary-03-lab/src/domain/command-doctrine';
const O='artifacts/build-diary-03/research';const originalIone=[...content.characters.find(c=>c.id==='ione')!.skillIds];content.skills.push({id:RECEIPT,name:'宛先の控え（研究案）',template:'buff',strength:16,soundProfile:'buff'});content.skills.push({id:'research-postmaster-charm',name:'名を取り違える呼び声',template:'charm',strength:20,soundProfile:'debuff'});content.characters.push({...structuredClone(content.characters.find(c=>c.id==='pale-wolf')!),id:'research-misaddressed-postmaster',name:'宛先を違える配達人',role:'debuffer',strength:20,skillIds:['research-postmaster-charm','attack-20']}as any);
content.dungeons.push({id:'research-return-to-sender',name:'名札の交差路（研究用）',subtitle:'狙いを、届ける。',description:'敵の魅了は通常70%。最初の魅了はR2、その後はnative CD4。R8から強い全体攻撃。控えは公開敵UIDだけを記録し、味方へ誤配された通常攻撃1回の宛先だけを戻す。',artId:'pale-wolf-art',published:true,kind:'trial',towerFloor:999,bossScale:{hp:900,attack:150},bossClock:{shield:0,brokenDefensePercent:100,deadline:8,finalePower:1200,shieldName:'交差路には再生障壁なし',finaleName:'閉門の行列'},waves:[[{characterId:'research-misaddressed-postmaster',boss:true}]]}as any);
function settle(b:any){if(b.phase==='playing'){b.cursor=b.events.length-1;return advanceReplay(b,content);}return b;}
export function trial(opt:any={},seed=1){const ids=opt.party??['ione','nox','liora-awakened','fio'],leader=opt.leader??ids[0],tier=opt.tier??3;content.characters.find(c=>c.id==='ione')!.skillIds=opt.skill===false?[...originalIone]:originalIone.map(x=>x==='buff-16'?RECEIPT:x);const gs=opt.gems??ids.map((id:string)=>gem(['liora-awakened','athena','neri'].includes(id)?'pale-ward':['fio','benzaiten','elaine-awakened','selene'].includes(id)?'twin-tide':opt.cleanse&&id===ids[0]?'clear-tear':'echo-shard',tier,(opt.cleanse&&id===ids[0])||['ione','liora-awakened','athena','neri','fio','benzaiten','elaine-awakened','selene'].includes(id)?'bulwark':'mercy',tier));if(!valid({party:ids,leader,gems:gs}))throw Error('Invalid config '+JSON.stringify(opt));const stage=content.dungeons.find(d=>d.id==='research-return-to-sender')!;stage.bossScale={hp:opt.hpScale??900,attack:opt.attackScale??150};stage.bossClock!.deadline=opt.deadline??8;let b:any=createBattle(content,ids,leader,stage.id,opt.potions??5,seed,'ione-'+seed);b.memoryGems=Object.fromEntries(ids.map((id:string,i:number)=>[id,{...gs[i],id:'slot-'+i}]));b.units.find((u:any)=>u.side==='enemy').cooldowns['research-postmaster-charm']=2;if(opt.prepare)opt.prepare(b);b=settle(b);const captureFixture=structuredClone(b),captureSteps:any[]=[],trace:any[]=[];let rounds=0,pots=0,flowers=0,fairies=0,corrections=0,friendlyHits=0,friendlyDamage=0;
function step(kind:string,after:any,command?:any){if(opt.record)captureSteps.push({kind,command,before:structuredClone(b),after:structuredClone(after)});b=settle(after);}
while(!['reward','failed'].includes(b.phase)&&rounds<40){const alive=b.units.filter((u:any)=>u.side==='party'&&u.hp>0),low=[...alive].sort((a:any,c:any)=>a.hp/a.maxHp-c.hp/c.maxHp)[0];if(!low)break;if(opt.sideActions!==false){if(low.hp<low.maxHp*.65&&b.potionsRemaining&&!b.potionUsed){step('potion',usePotion(b,low.uid),{type:'potion',unitId:low.uid});pots++;continue;}if(b.fairies?.visitor){step('battleFairy',useBattleFairy(b,b.fairies.visitor.id,content),{type:'battleFairy',fairyId:b.fairies.visitor.id});fairies++;continue;}if(b.blooms?.flower){step('battleBloom',useBattleBloom(b,b.blooms.flower.id,content).battle,{type:'battleBloom',bloomId:b.blooms.flower.id});flowers++;continue;}}
b.strategy='survival';b.crystalRole=low.hp<low.maxHp*.7?'healer':'attacker';const boss=b.units.find((u:any)=>u.side==='enemy'&&u.hp>0);b.focusTargetId=boss.uid;for(const u of alive)if(u.characterId!==ids[0]&&u.ultimateCharge===100)u.ultimateQueued=true;const pilot=alive.find((u:any)=>u.characterId===ids[0]);if(pilot){const opts=partyOrderOptions(pilot,b,content).filter(o=>!o.disabled);const strong=alive.filter((u:any)=>u.uid!==pilot.uid).sort((a:any,c:any)=>c.attack-a.attack)[0];const rem=b.round%4;const wants=opt.mode==='late'?rem===2||rem===3:rem===1||rem===2;const receipt=opts.find(o=>o.order?.kind==='skill'&&o.order.skillId===RECEIPT);if(receipt&&strong&&wants&&opt.mode!=='no-receipt'){b.researchReceiptAlly=opt.mode==='wrong-recipient'?alive.find((u:any)=>u.characterId==='fio')?.uid:strong.uid;b.partyOrder=receipt.order;}else{delete b.researchReceiptAlly;const cleanse=opts.find(o=>o.template==='cleanse');const afflicted=alive.some((u:any)=>u.ailments);const closing=stage.bossClock!.deadline-b.round<=1;const support=content.characters.find(c=>c.id===pilot.characterId)!.role==='supporter';const ult=!(closing&&support&&opt.defensiveUltimate!==true)?opts.find(o=>o.id==='ultimate'):undefined;const damage=opts.find(o=>o.id.startsWith('skill:memory:')&&['attack','pierce','drain','dawn'].includes(o.template))??opts.find(o=>['attack','pierce','drain','dawn'].includes(o.template));b.partyOrder=(opt.cleanse&&afflicted?cleanse?.order:ult?.order??damage?.order)??undefined;}}
if(opt.command&&leader.startsWith('noelle')){delete b.partyOrder;try{b.commandOrder=validateCommandOrder({targetId:boss.uid,followerIds:alive.filter((u:any)=>u.characterId==='nox').map((u:any)=>u.uid)},b,content);}catch{}}
const before=b.round,after=resolveRound(b,content).battle;corrections+=after.events.filter((e:any)=>e.text.startsWith('研究：誤配を差戻し')).length;const friendly=after.events.filter((e:any)=>e.statusAction==='friendly_fire');friendlyHits+=friendly.length;friendlyDamage+=friendly.reduce((s:number,e:any)=>s+(e.amount??0),0);trace.push({round:before,bossHP:after.units.find((u:any)=>u.side==='enemy').hp,party:after.units.filter((u:any)=>u.side==='party').map((u:any)=>({id:u.characterId,hp:u.hp,maxHp:u.maxHp,ailments:u.ailments,receipt:u.researchReceipt,charge:u.ultimateCharge})),events:after.events.map((e:any)=>({text:e.text,amount:e.amount,actorId:e.actorId,targetIds:e.targetIds,skillId:e.skillId,statusAction:e.statusAction,ailment:e.ailment}))});step('round',after);rounds++;}
return{seed,win:b.phase==='reward',rounds,survivors:b.units.filter((u:any)=>u.side==='party'&&u.hp>0).length,pots,flowers,fairies,corrections,friendlyHits,friendlyDamage,bossHP:b.units.find((u:any)=>u.side==='enemy').hp,...(opt.record?{trace,captureFixture,captureSteps,finalBattle:structuredClone(b)}:{})};}
export{content};
if(process.env.LIB_ONLY!=='1'){const configs=[{id:'ione-main',opt:{}},{id:'safety-without-finishing-hit',opt:{defensiveUltimate:true}},{id:'same-party-without-new-skill',opt:{skill:false}},{id:'receipt-too-late',opt:{mode:'late'}},{id:'wrong-recipient',opt:{mode:'wrong-recipient'}},{id:'cleanse-tikka',opt:{party:['tikka','nox','liora-awakened','fio'],cleanse:true}},{id:'cleanse-fast-tank',opt:{party:['athena','nox','liora-awakened','fio'],cleanse:true}},{id:'noelle-command',opt:{party:['noelle','nox','liora-awakened','fio'],command:true}},{id:'low-speed-damage',opt:{party:['ione','noelle-awakened','liora-awakened','fio']}},{id:'t6-burst-no-ione',opt:{party:['astraea','seris-awakened','nox','eos'],tier:6}},{id:'athena-turtle-no-ione',opt:{party:['athena','selene','elaine-awakened','benzaiten'],tier:6}},{id:'ione-no-side-actions',opt:{sideActions:false}},{id:'ione-tier1',opt:{tier:1}}];const cases=[];for(const c of configs){const rows=[];for(let seed=1;seed<=100;seed++)rows.push(trial(c.opt,seed));const q={...c,n:100,wins:rows.filter(x=>x.win).length,meanRounds:rows.reduce((s,r)=>s+r.rounds,0)/100,meanFriendlyDamage:rows.reduce((s,r)=>s+r.friendlyDamage,0)/100,meanCorrections:rows.reduce((s,r)=>s+r.corrections,0)/100,rows};cases.push(q);writeFileSync(`${O}/${c.id}-seed1.json`,JSON.stringify(trial({...c.opt,record:true},1),null,2));console.log(c.id,q.wins,q.meanRounds,q.meanFriendlyDamage,q.meanCorrections);}writeFileSync(`${O}/research-summary.json`,JSON.stringify({cases},null,2));trial({},1);writeFileSync(`${O}/research-lab-content.json`,JSON.stringify(content,null,2));}
