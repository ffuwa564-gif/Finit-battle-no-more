const O='artifacts/build-diary-03/research';const original=structuredClone(content.characters.find(c=>c.id==='neri')!.skillIds);
content.skills.push({id:REST,name:'休番の札（研究案）',template:'barrier',strength:13,soundProfile:'barrier'});content.characters.find(c=>c.id==='neri')!.skillIds=original.map(x=>x==='scout-neri-lantern'?REST:x);
const foe={...structuredClone(content.characters.find(c=>c.id==='pale-wolf')!),id:'research-night-watch',name:'追いすがる夜番の影',strength:10,role:'attacker',skillIds:['attack-10']}as any;content.characters.push(foe);
content.dungeons.push({id:'research-watch-relay',name:'夜明けの渡し舟（研究用）',subtitle:'12R・3人以上で帰還',description:'前線に6R連続滞在すると過労で離脱。休番中のみ連勤0。12Rに3人以上生存で護衛成功。敵は倒せない規模。',artId:'pale-wolf-art',published:true,kind:'trial',towerFloor:999,bossScale:{hp:1e12,attack:260},bossStrike:{every:4,power:260,name:'門を叩く追撃',target:'pilot',windup:{breakPercent:5,weakenedPower:65,recoveryPercent:50}},waves:[[{characterId:foe.id,boss:true}]]} as any);
function settle(b:any){if(b.phase==='playing'){b.cursor=b.events.length-1;return advanceReplay(b,content);}return b;}
export function trial(opt:any={},seed=1){const ids=opt.party??['neri','nox','liora-awakened','fio'],leader=opt.leader??'neri',tier=opt.tier??4;const gs=opt.gems??ids.map((id:string)=>gem(['neri','athena','liora','liora-awakened'].includes(id)?'pale-ward':['fio','elaine-awakened','selene','benzaiten'].includes(id)?'twin-tide':'echo-shard',tier,['neri','athena','liora','liora-awakened','fio','elaine-awakened','selene','benzaiten'].includes(id)?'bulwark':'mercy',tier));if(!valid({party:ids,leader,gems:gs}))throw Error('Invalid config');content.dungeons.find(d=>d.id==='research-watch-relay')!.bossScale!.attack=opt.enemyAttack??260;let b:any=createBattle(content,ids,leader,'research-watch-relay',opt.potions??5,seed,'neri-'+seed);b.memoryGems=Object.fromEntries(ids.map((id:string,i:number)=>[id,{...gs[i],id:'slot-'+i}]));if(opt.prepare)opt.prepare(b);b.researchDutyRules={maxStreak:6,finishRound:12,minimumSurvivors:3};b=settle(b);const captureFixture=structuredClone(b),captureSteps:any[]=[],trace:any[]=[];let rounds=0,pots=0,flowers=0,fairies=0;
function step(kind:string,after:any,command?:any){if(opt.record)captureSteps.push({kind,command,before:structuredClone(b),after:structuredClone(after)});b=settle(after);}
while(!['reward','failed'].includes(b.phase)&&rounds<40){const alive=b.units.filter((u:any)=>u.side==='party'&&u.hp>0),low=[...alive].sort((a:any,c:any)=>a.hp/a.maxHp-c.hp/c.maxHp)[0];if(!low)break;if(opt.sideActions!==false){if(low.hp<low.maxHp*.7&&b.potionsRemaining&&!b.potionUsed){step('potion',usePotion(b,low.uid),{type:'potion',unitId:low.uid});pots++;continue;}if(b.fairies?.visitor){step('battleFairy',useBattleFairy(b,b.fairies.visitor.id,content),{type:'battleFairy',fairyId:b.fairies.visitor.id});fairies++;continue;}if(b.blooms?.flower){step('battleBloom',useBattleBloom(b,b.blooms.flower.id,content).battle,{type:'battleBloom',bloomId:b.blooms.flower.id});flowers++;continue;}}
b.strategy='survival';b.crystalRole=low.hp<low.maxHp*.8?'healer':'attacker';b.focusTargetId=b.units.find((u:any)=>u.side==='enemy'&&u.hp>0).uid;for(const u of alive)if(u.characterId!==ids[0]&&u.ultimateCharge===100)u.ultimateQueued=true;const pilot=alive.find((u:any)=>u.characterId===ids[0]);if(pilot){const opts=partyOrderOptions(pilot,b,content).filter(o=>!o.disabled);let target:string|undefined;const plan=opt.plan??[ids[1],ids[2],ids[3],ids[0],null];target=plan[(b.round-1)%plan.length]??undefined;if(opt.mode==='same-only')target=ids[1];if(opt.mode==='never-self'&&target===ids[0])target=ids[1];if(opt.mode==='no-rest')target=undefined;const rest=opts.find(o=>o.order?.kind==='skill'&&o.order.skillId===REST);if(rest&&target){b.researchRestTarget='party:'+target;b.partyOrder=rest.order;}else{delete b.researchRestTarget;b.partyOrder=opts.find(o=>o.id==='ultimate')?.order??{kind:'attack'};}}
const before=b.round;const after=resolveRound(b,content).battle;trace.push({round:before,party:after.units.filter((u:any)=>u.side==='party').map((u:any)=>({id:u.characterId,hp:u.hp,maxHp:u.maxHp,duty:u.researchDutyStreak??0,restRound:u.researchRestRound,resting:u.researchRestRound===before})),events:after.events.map((e:any)=>({text:e.text,amount:e.amount,actorId:e.actorId,skillId:e.skillId}))});step('round',after);rounds++;}
return{seed,win:b.phase==='reward',rounds,survivors:b.units.filter((u:any)=>u.side==='party'&&u.hp>0).length,pots,flowers,fairies,bossHP:b.units.find((u:any)=>u.side==='enemy').hp,objectiveFailed:b.researchDutyRules.objectiveFailed??false,minimumHpRatio:Math.min(...trace.flatMap((r:any)=>r.party.map((u:any)=>u.hp/u.maxHp))),meanEndHpRatio:b.units.filter((u:any)=>u.side==='party').reduce((s:number,u:any)=>s+u.hp/u.maxHp,0)/ids.length,...(opt.record?{trace,captureFixture,captureSteps,finalBattle:structuredClone(b)}:{})};}
export{content};
if(process.env.LIB_ONLY!=='1'){const configs=[{id:'neri-main',opt:{}},{id:'no-rest',opt:{mode:'no-rest'}},{id:'never-self',opt:{mode:'never-self'}},{id:'same-only',opt:{mode:'same-only'}},{id:'rest-order-reversed',opt:{plan:['fio','liora-awakened','nox','neri',null]}},{id:'neri-all-partners-replaced',opt:{party:['neri','seris-awakened','liora-awakened','benzaiten']}},{id:'no-neri-t6',opt:{party:['astraea','seris-awakened','nox','eos'],leader:'astraea',tier:6,mode:'no-rest'}},{id:'athena-t6',opt:{party:['athena','selene','elaine-awakened','benzaiten'],leader:'athena',tier:6,mode:'no-rest'}},{id:'solo-neri',opt:{party:['neri'],plan:['neri',null],tier:6}},{id:'no-side-actions',opt:{sideActions:false}},{id:'tier1',opt:{tier:1}},{id:'tier3',opt:{tier:3}},{id:'tier6',opt:{tier:6}},{id:'two-healers-no-guard',opt:{party:['neri','nox','elaine-awakened','fio']}},{id:'two-healers-no-guard-reverse',opt:{party:['neri','nox','elaine-awakened','fio'],plan:['fio','elaine-awakened','nox','neri',null]}}];const cases=[];for(const c of configs){const rows=[];for(let seed=1;seed<=100;seed++)rows.push(trial(c.opt,seed));const summary={...c,n:100,wins:rows.filter(x=>x.win).length,meanRounds:rows.reduce((s,r)=>s+r.rounds,0)/100,rows};cases.push(summary);writeFileSync(`${O}/${c.id}-seed1.json`,JSON.stringify(trial({...c.opt,record:true},1),null,2));console.log(c.id,summary.wins,summary.meanRounds);}writeFileSync(`${O}/research-summary.json`,JSON.stringify({cases},null,2));writeFileSync(`${O}/research-lab-content.json`,JSON.stringify(content,null,2));}
