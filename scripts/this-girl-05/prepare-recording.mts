import{run}from'./policy.mts';import{readFileSync,writeFileSync,mkdirSync}from'node:fs';import{gunzipSync}from'node:zlib';import{createHash}from'node:crypto';import{execFileSync}from'node:child_process';const O='artifacts/this-girl-05',sha=(p:string)=>createHash('sha256').update(readFileSync(p)).digest('hex'),lp=O+'/research/confirmation-lock.json',lock=JSON.parse(readFileSync(lp,'utf8')),a=JSON.parse(readFileSync(O+'/research/analysis/main.json','utf8'));if(!a.adoption.passed||a.lockSha256!==sha(lp))throw Error('Adoption first');const witness=new Set(a.adoption.witnesses.map(x=>x.caseId)),priority=['ivory-tower-004-T6-F1','ivory-tower-004-T6-F2','ivory-tower-004-T4-F1','ivory-tower-004-T4-F2','ivory-tower-010-T6-F1','ivory-tower-010-T6-F2',...lock.cases.map(x=>x.id).sort()];let selected:any;for(const id of[...new Set(priority)].filter(id=>witness.has(id))){const spec=lock.cases.find(x=>x.id===id),d=JSON.parse(gunzipSync(readFileSync(O+'/research/confirmation/'+id+'.json.gz')).toString());for(let i=0;i<lock.seedMap.length;i++){const c=d.arms.C.rows[i],b=d.arms.B.rows[i];if(!c.win||!b.win||c.rounds>40||b.rounds>40||!c.strikes)continue;selected={caseId:id,stageId:spec.stage,tier:spec.tier,logicalSeed:c.logical,applicationSeed:c.seed,arms:{M:spec.arms.C,A:spec.arms.B},rowM:c,rowA:b,selectionPolicy:lock.recordingSelection};break;}if(selected)break;}if(!selected)throw Error('No eligible recorded witness');mkdirSync(O+'/proofs',{recursive:true});writeFileSync(O+'/research/recording-selection.json',JSON.stringify(selected,null,2));const head=execFileSync('git',['rev-parse','HEAD'],{encoding:'utf8'}).trim();for(const[id,key,model]of[['reference','A','before'],['lisette','M','after']]as const){const spec={id,caseId:selected.caseId,arm:key==='A'?'A':'C',model,preflight:false,stageId:selected.stageId,applicationSeed:selected.applicationSeed,logicalSeed:selected.logicalSeed,config:selected.arms[key].config,sourceGameCommit:head,researchLockCommit:lock.sourceGameCommit,researchLockSha256:sha(lp),disclosure:'Same input and budgets; independently selected configs may differ. All-owned hypothetical stress save.'};const p=O+'/proofs/spec-'+id+'.json';writeFileSync(p,JSON.stringify(spec,null,2));execFileSync('npx',['tsx','scripts/this-girl-05/capture/prepare-proof.mts',p],{stdio:'inherit',env:{...process.env,VITE_SAKUYA_RESEARCH:'0',VITE_MIETTE_RESEARCH:'0',VITE_TIKKA_RESEARCH:'0',VITE_NOELLE_RESEARCH:'0',VITE_LISETTE_RESEARCH:model==='after'?'1':'0'}});const proof=JSON.parse(gunzipSync(readFileSync(O+'/proofs/'+id+'.json.gz')).toString()),row=key==='M'?selected.rowM:selected.rowA;for(const k of['win','rounds','pots','survivors'])if(proof.nativeSummary[k]!==row[k])throw Error('App differs '+k);}console.log('SELECTED',selected.caseId,selected.logicalSeed,selected.rowM,selected.rowA);
