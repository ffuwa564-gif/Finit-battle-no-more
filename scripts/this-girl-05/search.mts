import{content,run,gem,type Config}from'./policy.mts';import{setMode,resetMode}from'./modes.mts';import{createHash}from'node:crypto';import{writeFileSync,mkdirSync}from'node:fs';import{gzipSync}from'node:zlib';
const O='artifacts/this-girl-05/research';mkdirSync(O+'/search',{recursive:true});export const cases=['kuzuha-awakening','ivory-tower-010','ivory-tower-004'].flatMap(stage=>[3,4,6].flatMap(tier=>[['seris-awakened','athena','benzaiten'],['liora-awakened','selene','astraea']].map((core,i)=>({id:`${stage}-T${tier}-F${i+1}`,stage,tier,core}))));
const spec=cases[Number(process.argv[2])];if(!spec)throw Error('Bad case');const seed=(d:string,n:number)=>createHash('sha256').update('STILLVEIL:this-girl-05:'+d+':v1:'+n).digest().readUInt32LE(0);
function configs(id:string){const party=[id,...spec.core];return [0,1,2].flatMap(policy=>[0,1,2].flatMap(pattern=>[id,spec.core[1]].map(leader=>({party,leader,gems:party.map((_,i)=>pattern===1&&i===0?null:gem(pattern===2&&i===0?'hollow-lantern':'echo-shard',spec.tier,i%2?'mercy':'bulwark',spec.tier)),policy,autoPilot:true} as Config))));}
const rank=(a:any,b:any)=>b.wins-a.wins||a.R-b.R||a.pots-b.pots||b.full-a.full;function ev(c:Config,d:string,n:number){const rows=Array.from({length:n},(_,i)=>{const r=run(c,seed(d,i),true,spec.stage);return{win:r.win,R:r.win?r.rounds:120,pots:r.pots,full:r.win&&r.survivors===4,strikes:r.events.filter(e=>e.text.includes('返し刃・斬撃')).length};});return{config:c,wins:rows.filter(r=>r.win).length,R:rows.reduce((s,r)=>s+r.R,0)/n,pots:rows.reduce((s,r)=>s+r.pots,0)/n,full:rows.filter(r=>r.full).length,strikes:rows.reduce((s,r)=>s+r.strikes,0),rows};}
function select(id:string){const development=configs(id).map(c=>ev(c,'development',16));const distinct=new Map<string,any>();for(const compare of[rank,(a:any,b:any)=>b.wins-a.wins||a.pots-b.pots||a.R-b.R,(a:any,b:any)=>b.wins-a.wins||b.full-a.full||a.R-b.R]){const x=[...development].sort(compare)[0];distinct.set(JSON.stringify(x.config),x);}const selection=[...distinct.values()].map(x=>ev(x.config,'selection',32));return{candidateCount:18,development,selection,best:[...selection].sort(rank)[0]};}
setMode('before');const B=select('lisette');setMode('after');const C=select('lisette'),alternatives=['lisette-awakened','hecate','kukurihime','rainbow-iris','nox','astraea'].filter(id=>!spec.core.includes(id)).map(id=>({id,...select(id)}));const A=[...alternatives].sort((a,b)=>rank(a.best,b.best))[0];resetMode();writeFileSync(O+'/search/'+spec.id+'.json.gz',gzipSync(JSON.stringify({spec,B,C,alternatives,A})));console.log(spec.id,'before',B.best.wins,B.best.R,'after',C.best.wins,C.best.R,'strikes',C.best.strikes,'alternative',A.id,A.best.R);
