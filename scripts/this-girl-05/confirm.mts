import{readFileSync,writeFileSync,mkdirSync}from'node:fs';import{createHash}from'node:crypto';import{gzipSync}from'node:zlib';import{run,content}from'./policy.mts';import{setMode,resetMode}from'./modes.mts';const R='artifacts/this-girl-05/research',sha=(p:string)=>createHash('sha256').update(readFileSync(p)).digest('hex'),lp=R+'/confirmation-lock.json',lock=JSON.parse(readFileSync(lp,'utf8')),h=sha(lp);if(process.env.CONFIRM_LOCK_SHA!==h)throw Error('Exact lock required');for(const[p,s]of Object.entries(lock.sources))if(sha(p)!==s)throw Error('Changed source '+p);const spec=lock.cases[Number(process.argv[2])];if(content.appVersion!==lock.sourceAppVersion)throw Error('Wrong mode');const out:any={spec,lockSha:h,arms:{}};for(const[name,arm]of Object.entries(spec.arms)as any){setMode(arm.mode);const rows=lock.seedMap.map((entry:any)=>{const r=run(arm.config,entry.applicationSeed,true,spec.stage);const events=r.events.filter(e=>e.actorId==='party:lisette'),hits=events.filter(e=>e.text.includes('返し刃・斬撃'));return{logical:entry.logical,seed:entry.applicationSeed,win:r.win,rounds:r.rounds,cappedRounds:r.win?r.rounds:120,pots:r.pots,survivors:r.survivors,fullAliveWin:r.win&&r.survivors===4,strikes:hits.length,strikeDamage:hits.reduce((s,e)=>s+(e.amount??0),0),dispelUses:events.filter(e=>e.actionSelection&&e.skillId==='dispel-18').length};});resetMode();out.arms[name]={...arm,rows};}for(const[p,s]of Object.entries(lock.sources))if(sha(p)!==s)throw Error('Changed source '+p);mkdirSync(R+'/confirmation',{recursive:true});writeFileSync(R+'/confirmation/'+spec.id+'.json.gz',gzipSync(JSON.stringify(out)));console.log(spec.id,Object.fromEntries(Object.entries(out.arms).map(([k,v]:any)=>[k,{wins:v.rows.filter(r=>r.win).length,R:v.rows.reduce((s,r)=>s+r.cappedRounds,0)/256,damage:v.rows.reduce((s,r)=>s+r.strikeDamage,0)}])));
