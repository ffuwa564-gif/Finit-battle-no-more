import{readFileSync,writeFileSync}from'node:fs';import{gunzipSync}from'node:zlib';import{run}from'./policy.mts';import{setMode,resetMode}from'./modes.mts';import{createHash}from'node:crypto';const R='artifacts/this-girl-05/research';const out=[];for(const stage of['ivory-tower-004','ivory-tower-008','ivory-tower-020','goddess-procession-ultimate','moonshield-rehearsal'])for(const F of[1,2]){const d=JSON.parse(gunzipSync(readFileSync(R+`/search/kuzuha-awakening-T3-F${F}.json.gz`)).toString());const modes:any={};for(const m of['before','after']as const){setMode(m);const rows=Array.from({length:16},(_,i)=>run(d.C.best.config,createHash('sha256').update('STILLVEIL:this-girl-05:development:v1:'+i).digest().readUInt32LE(0),true,stage));modes[m]={wins:rows.filter(r=>r.win).length,R:rows.reduce((s,r)=>s+(r.win?r.rounds:120),0)/16,pots:rows.reduce((s,r)=>s+r.pots,0)/16,strikes:rows.reduce((s,r)=>s+r.events.filter(e=>e.text.includes('返し刃・斬撃')).length,0)};}out.push({stage,F,...modes});console.log(stage,F,modes);}resetMode();writeFileSync(R+'/stage-development.json',JSON.stringify(out,null,2));
