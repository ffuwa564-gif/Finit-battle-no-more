/** Current shipped rules only: a broad screen, not proof of exclusive viability. */
import{content,run,gem}from'../diary-part3/core';import{writeFileSync}from'node:fs';
const cases=[];for(let floor=1;floor<=100;floor++)for(const id of['ruka','eos']){const outcomes=[];for(let seed=1;seed<=5;seed++)outcomes.push(run({party:[id,'nox','athena','benzaiten'],leader:'athena',gems:[gem('echo-shard',6,'bulwark',6),gem('echo-shard',6,'mercy',6),gem('pale-ward',6,'bulwark',6),gem('twin-tide',6,'bulwark',6)],autoPilot:true,policy:2},seed,false,floor));cases.push({floor,id,name:content.characters.find(c=>c.id===id)!.name,n:5,wins:outcomes.filter(r=>r.win).length,meanRounds:outcomes.reduce((s,r)=>s+r.rounds,0)/5});}
const exclusiveScreen=Array.from({length:100},(_,i)=>i+1).filter(f=>cases.find(r=>r.floor===f&&r.id==='ruka')!.wins>0&&cases.find(r=>r.floor===f&&r.id==='eos')!.wins===0);const out={type:'Current production engine; synthetic T6 upper-affix ownership, fixed policy, only two builds and seeds1..5, screening not exhaustive proof',totalBattles:1000,cases,apparentRukaOnlyFloorsAgainstThisOneComparator:exclusiveScreen};writeFileSync('artifacts/ruka-build-research/tower-sweep.json',JSON.stringify(out,null,2));console.log('CURRENT TOWER SWEEP',exclusiveScreen,'Ruka any-win floors',cases.filter(r=>r.id==='ruka'&&r.wins>0).length,'Eos any-win floors',cases.filter(r=>r.id==='eos'&&r.wins>0).length);
