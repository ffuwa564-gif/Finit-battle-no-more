import{content,run,gem}from'../diary-part3/core';import{writeFileSync}from'node:fs';
const ids=['ruka','astraea','seris-awakened','noelle-awakened','lunette-awakened','kuzuha-awakened','hecate','zakuro','elaine-awakened'];const cases=[];
for(const floor of[20,30])for(const id of ids){const rows=[];for(let seed=1;seed<=20;seed++)rows.push(run({party:[id,'nox','athena','benzaiten'],leader:'athena',gems:[gem('echo-shard',6,'bulwark',6),gem('echo-shard',6,'mercy',6),gem('pale-ward',6,'bulwark',6),gem('twin-tide',6,'bulwark',6)],autoPilot:true,policy:2},seed,false,floor));cases.push({floor,id,name:content.characters.find(c=>c.id===id)!.name,n:20,wins:rows.filter(r=>r.win).length,meanRounds:rows.reduce((s,r)=>s+r.rounds,0)/20});}
writeFileSync('artifacts/ruka-build-research/current-candidate-counters.json',JSON.stringify({type:'Current production engine, explicit counterexamples to the small initial screen; synthetic T6 upper affixes, fixed control, seeds1..20',cases,totalBattles:cases.reduce((s,r)=>s+r.n,0)},null,2));console.log(cases);
