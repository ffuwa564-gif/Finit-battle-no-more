import assert from'node:assert/strict';import{writeFileSync}from'node:fs';
import{capResearchDamage,capResearchHealing,collectResearchThread,researchSkill,finishResearchRound,STITCH,threadCount}from'/tmp/stillveil-ruka-build-lab/src/domain/research-ruka';
import{scoutDamageMultiplier,SCOUT_SKILLS}from'/tmp/stillveil-ruka-build-lab/src/domain/scout-skills';
const checks:any[]=[];function check(name:string,fn:()=>void){fn();checks.push({name,passed:true});}
function fixture(){return{wave:0,round:4,leaderId:'ruka',focusTargetId:'boss',researchRules:{cap:300,period:4,stockEnabled:false,rewindEnabled:true,releaseCapOnWound:true},units:[{uid:'ruka',characterId:'ruka',side:'party',hp:100,maxHp:200,scoutThreadUntil:4},{uid:'boss',characterId:'research-unravelling-loom',side:'enemy',boss:true,hp:4000,maxHp:4800}]};}
check('All sources share one per-round HP budget, regardless of source count',()=>{const b=fixture(),e=b.units[1];assert.equal(Array.from({length:50},()=>capResearchDamage(b,e,999999)).reduce((a,c)=>a+c,0),300);});
check('A new round grants exactly one fresh damage budget',()=>{const b=fixture(),e=b.units[1];capResearchDamage(b,e,100000);b.round++;assert.equal(capResearchDamage(b,e,100000),300);assert.equal(capResearchDamage(b,e,100000),0);});
check('Party HP loss is never capped by the enemy membrane',()=>{const b=fixture();assert.equal(capResearchDamage(b,b.units[0],999),999);});
check('New wound removes the common cap for the two stated rounds, then expires',()=>{const b:any=fixture(),e=b.units[1];researchSkill(b,b.units[0],STITCH);assert.equal(capResearchDamage(b,e,9999),9999);b.round++;assert.equal(capResearchDamage(b,e,9999),9999);b.round++;assert.equal(capResearchDamage(b,e,9999),300);});
check('Damage already spent before wound does not constrain the open window',()=>{const b:any=fixture(),e=b.units[1];assert.equal(capResearchDamage(b,e,9999),300);researchSkill(b,b.units[0],STITCH);assert.equal(capResearchDamage(b,e,9999),9999);});
check('Wound blocks enemy HP recovery, not party healing',()=>{const b=fixture();researchSkill(b,b.units[0],STITCH);assert.equal(capResearchHealing(b,b.units[1],1000),0);assert.equal(capResearchHealing(b,b.units[0],1000),1000);});
check('Healing resumes when the debuff expires',()=>{const b=fixture();researchSkill(b,b.units[0],STITCH);b.round+=2;assert.equal(capResearchHealing(b,b.units[1],1000),1000);});
check('A forged personal skill on another actor cannot grant wound',()=>{const b:any=fixture();b.units[0].characterId='noelle';researchSkill(b,b.units[0],STITCH);assert.equal(b.units[1].researchWoundUntil,undefined);});
check('Having Ruka without a thread cannot stop restoration',()=>{const b:any=fixture();delete b.units[0].scoutThreadUntil;researchSkill(b,b.units[0],STITCH);finishResearchRound(b);assert.equal(b.units[1].hp,4800);});
check('Spending a thread on the new skill prevents spending it on the old attack bonus',()=>{const b=fixture();researchSkill(b,b.units[0],STITCH);assert.equal(threadCount(b,b.units[0]),0);assert.equal(scoutDamageMultiplier(b as any,b.units[0]as any,SCOUT_SKILLS.shear),1.3);});
check('Spending a thread on the old attack prevents the new skill',()=>{const b:any=fixture();assert(Math.abs(scoutDamageMultiplier(b,b.units[0],SCOUT_SKILLS.shear)-1.69)<1e-9);researchSkill(b,b.units[0],STITCH);assert.equal(b.units[1].researchWoundUntil,undefined);});
check('Zero, broken, consumed or living barriers do not mint stored threads',()=>{for(const mode of['zero','removed','active','dead']){const b:any=fixture();b.researchRules.stockEnabled=true;delete b.units[0].scoutThreadUntil;b.units.push({uid:'host',side:'party',hp:mode==='dead'?0:100,barrier:mode==='zero'?0:mode==='removed'?undefined:60,barrierUntil:mode==='active'?5:3});collectResearchThread(b);assert.equal(b.units[0].researchStock??0,0);}});
check('Optional storage has a cap and multiple expiring allies give one token per round',()=>{const b:any=fixture();b.researchRules.stockEnabled=true;b.units[0].researchStock=1;for(let i=0;i<10;i++)b.units.push({uid:'host'+i,side:'party',hp:100,barrier:60,barrierUntil:3});collectResearchThread(b);assert.equal(b.units[0].researchStock,2);});
check('Final recommendation disables the experimental new leader storage',()=>{const b:any=fixture();b.units.push({uid:'host',side:'party',hp:100,barrier:60,barrierUntil:3});collectResearchThread(b);assert.equal(b.units[0].researchStock,undefined);});
check('Sleep, paralysis, charm, confusion and skill-CD lock cannot postpone encounter restoration',()=>{for(const ailment of['sleep','paralysis','charm','confusion']){const b:any=fixture();b.units[1].ailments={[ailment]:{turns:99,sourceId:'ruka'}};b.units[1].cooldowns={'attack-10':99};finishResearchRound(b);assert.equal(b.units[1].hp,4800);}});
check('Wound stops the environmental HP restore without killing or disabling its actor',()=>{const b:any=fixture();researchSkill(b,b.units[0],STITCH);finishResearchRound(b);assert.equal(b.units[1].hp,4000);assert.equal(b.researchRules.blocked,1);});
writeFileSync('artifacts/ruka-build-research/edge-checks.json',JSON.stringify({passed:true,checks},null,2));console.log('EDGE CHECKS PASSED',checks.length);
