import{readFileSync,writeFileSync,mkdirSync}from'node:fs';import{createHash}from'node:crypto';import{gzipSync}from'node:zlib';import{content,run}from'./policy.mts';import{setMode,resetMode,type Mode}from'./modes.mts';import{traceJam}from'./trace-jam.mts';
const O='artifacts/this-girl-03-v2/research',sha=(p:string)=>createHash('sha256').update(readFileSync(p)).digest('hex'),lp=O+'/confirmation-lock.json',lock=JSON.parse(readFileSync(lp,'utf8')),h=sha(lp);if(process.env.CONFIRM_LOCK_SHA!==h)throw Error('Exact lock SHA required');for(const[p,s]of Object.entries(lock.sources))if(sha(p)!==s)throw Error('Frozen source changed '+p);if(content.appVersion!==lock.sourceAppVersion)throw Error('Wrong research mode');const smoke=process.argv.includes('--development-preflight');const spec=lock.cases[Number(process.argv[2])];if(!spec)throw Error('Bad case');const out:any={spec,lockSha:h,arms:{}};const pristine=createHash('sha256').update(JSON.stringify(content)).digest('hex');
for(const[name,arm]of Object.entries(spec.arms)as any){setMode(arm.mode as Mode);const rows=[];try{for(const entry of(smoke?lock.developmentSeeds.slice(0,2).map((applicationSeed,i)=>({logical:920001+i,applicationSeed})):lock.seedMap)){const r=run(arm.config,entry.applicationSeed,true,spec.stage);const t=traceJam(r.events);rows.push({logical:entry.logical,seed:entry.applicationSeed,win:r.win,rounds:r.rounds,cappedRounds:r.win?r.rounds:120,pots:r.pots,survivors:r.survivors,fullAliveWin:r.win&&r.survivors===4,...Object.fromEntries(Object.entries(t).filter(([k])=>k!=='traces'))});}}finally{resetMode();}if(createHash('sha256').update(JSON.stringify(content)).digest('hex')!==pristine)throw Error('Counterfactual leaked');out.arms[name]={...arm,rows};}
for(const[p,s]of Object.entries(lock.sources))if(sha(p)!==s)throw Error('Source changed during run');mkdirSync(O+(smoke?'/preflight':'/confirmation'),{recursive:true});writeFileSync(O+(smoke?'/preflight/':'/confirmation/')+spec.id+'.json.gz',gzipSync(JSON.stringify(out)));console.log(spec.id,Object.fromEntries(Object.entries(out.arms).map(([k,v]:any)=>[k,{wins:v.rows.filter(r=>r.win).length,pots:v.rows.reduce((s,r)=>s+r.pots,0)/v.rows.length,fourAlive:v.rows.filter(r=>r.fullAliveWin).length,relayGrants:v.rows.reduce((s,r)=>s+r.relayGrants,0)}])));
