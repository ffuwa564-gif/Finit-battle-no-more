import{readFileSync,writeFileSync,existsSync}from'node:fs';import{gunzipSync}from'node:zlib';import{createHash}from'node:crypto';import{traceJam}from'./trace-jam.mts';
const O='artifacts/this-girl-03-v2',sha=(p:string)=>createHash('sha256').update(readFileSync(p)).digest('hex');const out:any={passed:true,scope:'Actual engine/application snapshots, source recording frame linkage. A single softened hit is an observed sequence, not a win-rate proof.'};
for(const id of['reference','tikka']){const path=O+'/proofs/'+id+'.json.gz',p=JSON.parse(gunzipSync(readFileSync(path)).toString()),t=traceJam(p.events),metaPath=O+'/capture/'+id+'.json',meta=existsSync(metaPath)?JSON.parse(readFileSync(metaPath,'utf8')):null,frames=new Map(meta?.battleEvents.map(x=>[x.event.id,x.sourceFrame])??[]);
const hits=t.traces.filter(e=>e.kind==='softened-attack');const hit=hits.find(e=>e.actualHpDamage>0)??hits[0];const jam=hit?[...t.traces].reverse().find(e=>e.kind==='jam'&&e.markApplied&&e.targetId===hit.actorId&&e.eventIndex<hit.eventIndex&&e.wave===hit.wave):t.traces.find(e=>e.kind==='jam'&&e.extendedSkillIds.length);if(!jam)throw Error('No genuine jam witness '+id);if(id==='tikka'&&!hit)throw Error('No real softened attack');
const bound=(e:any)=>e?{...e,sourceFrame:frames.get(e.eventId)??null,event:p.events[e.eventIndex]}:null;out[id]={party:p.config.party,leader:p.config.leader,jam:bound(jam),hit:bound(hit),allTraces:t.traces,proofSha256:sha(path),metadataSha256:meta?sha(metaPath):null,sourceSha256:meta?sha(O+'/capture/'+id+'.mov'):null};}
writeFileSync(O+'/research/mechanism-tikka.json',JSON.stringify(out,null,2));console.log('WITNESS EVENTS',JSON.stringify({reference:out.reference.jam,tikka:out.tikka.hit},null,2));
