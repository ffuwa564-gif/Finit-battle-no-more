import{readFileSync,readdirSync,writeFileSync}from'node:fs';import{gunzipSync}from'node:zlib';import{createHash}from'node:crypto';import{run}from'./policy.mts';import{setMode,resetMode,type Mode}from'./modes.mts';
const R='artifacts/this-girl-03-v2/research';const out=[];for(const f of readdirSync(R+'/search').filter(f=>f.endsWith('.diverse.json.gz')).sort()){const d=JSON.parse(gunzipSync(readFileSync(R+'/search/'+f)).toString()),m=d.results.find(x=>x.healer==='tikka').best.config,b=d.results.find(x=>x.healer==='tikka-before').best.config;const result:any={caseId:d.spec.id,developmentOnly:true,summaries:{}};for(const[arm,mode,cfg]of[['C','after',m],['E','no-relay',m],['N','no-exposure',m],['X','before',m],['B','before',b]]as const){setMode(mode);const rows=Array.from({length:32},(_,i)=>{const seed=createHash('sha256').update('STILLVEIL:this-girl-03-v2:development:v1:'+i).digest().readUInt32LE(0);const r=run(cfg,seed,false,d.spec.stage);return{win:r.win,pots:r.pots,rounds:r.win?r.rounds:120,alive:r.win&&r.survivors===4};});result.summaries[arm]={wins:rows.filter(x=>x.win).length,pots:rows.reduce((s,r)=>s+r.pots,0)/32,rounds:rows.reduce((s,r)=>s+r.rounds,0)/32,alive:rows.filter(x=>x.alive).length};}resetMode();out.push(result);console.log(result.caseId,JSON.stringify(result.summaries));}writeFileSync(R+'/development-ablation.json',JSON.stringify({developmentOnly:true,notConfirmation:true,conditions:out},null,2));
