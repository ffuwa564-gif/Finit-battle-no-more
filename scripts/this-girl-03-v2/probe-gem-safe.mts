import{readFileSync,writeFileSync}from'node:fs';import{gunzipSync}from'node:zlib';import{createHash}from'node:crypto';import{run}from'./policy.mts';import{setMode,resetMode}from'./modes.mts';
const R='artifacts/this-girl-03-v2/research',L=JSON.parse(readFileSync(R+'/attempt-03-relay-naive-operation/confirmation-lock.json','utf8'));const all=[];
for(const spec of L.cases){const row:any={caseId:spec.id,developmentOnly:true,arms:{}};for(const[name,mode,safe,key]of[['C','after',false,'C'],['CS','after',true,'C'],['X','before',false,'C'],['XS','before',true,'C'],['B','before',false,'B'],['BS','before',true,'B']]as const){setMode(mode);const cfg={...spec.arms[key].config,...(safe?{preserveGem:true}:{})};const rows=Array.from({length:32},(_,i)=>{const seed=createHash('sha256').update('STILLVEIL:this-girl-03-v2:development:v1:'+i).digest().readUInt32LE(0);const r=run(cfg,seed,false,spec.stage);return{win:r.win,pots:r.pots,rounds:r.win?r.rounds:120,alive:r.win&&r.survivors===4};});row.arms[name]={wins:rows.filter(x=>x.win).length,pots:rows.reduce((s,r)=>s+r.pots,0)/32,rounds:rows.reduce((s,r)=>s+r.rounds,0)/32,alive:rows.filter(x=>x.alive).length};}resetMode();all.push(row);console.log(row.caseId,JSON.stringify(row.arms));}writeFileSync(R+'/gem-safe-development-probe.json',JSON.stringify({developmentOnly:true,notConfirmation:true,cases:all},null,2));
