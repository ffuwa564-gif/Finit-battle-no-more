/** Actual event deltas. A later ultimate is an observed sequence, not a causal certificate. */
export function traceJam(events:any[]){let previous=new Map<string,any>();const pending=new Map<string,{wave:number,index:number}>();let jamUses=0,jamExtended=0,diagnosisUses=0,exposureApplied=0,relayGrants=0,relayCharge=0,relayFull=0,allyUltAfterRelay=0;const traces:any[]=[];
for(let i=0;i<events.length;i++){const e=events[i],parts=e.id?.match(/:w(\d+):r(\d+):/),wave=Number(parts?.[1]??-1),round=Number(parts?.[2]??-1);const units=new Map<string,any>((e.unitsAfter??[]).map(u=>[u.uid,u]));
 if(e.actorId==='party:tikka'&&e.skillId==='jam-14'&&e.actionSelection){jamUses++;diagnosisUses+=Number(e.text.includes('故障診断'));for(const id of e.targetIds??[]){const b=previous.get(id),a=units.get(id);if(!b||!a)throw Error('Missing jam snapshots');const extended=Object.keys(a.cooldowns).filter(k=>a.cooldowns[k]>(b.cooldowns[k]??0));jamExtended+=extended.length;const old=(b.debuffUntil??-1)>=round?b.debuffStrength??10:0;const exposed=(a.debuffUntil??-1)>=round&&(a.debuffStrength??0)>old;if(exposed)exposureApplied++;traces.push({kind:'jam',eventId:e.id,eventIndex:i,wave,round,targetId:id,targetCharacterId:a.characterId,extendedSkillIds:extended,cooldownsBefore:b.cooldowns,cooldownsAfter:a.cooldowns,defense:b.defense,exposureApplied:exposed,weaknessBefore:old,weaknessAfter:(a.debuffUntil??-1)>=round?a.debuffStrength:0,until:a.debuffUntil,diagnosisShown:e.text.includes('故障診断'),actorGaugeBefore:previous.get(e.actorId)?.ultimateCharge??0,actorGaugeAfter:units.get(e.actorId)?.ultimateCharge??0});}}
 if(e.jamRelay){const r=e.jamRelay,b=previous.get(r.recipientId),a=units.get(r.recipientId);if(e.actorId!=='party:tikka'||!b||!a||(a.ultimateCharge??0)-(b.ultimateCharge??0)!==r.charge||r.charge<=0||r.charge>25||a.ultimateQueued)throw Error('Invalid real relay delta');relayGrants++;relayCharge+=r.charge;const crosses=(b.ultimateCharge??0)<100&&a.ultimateCharge===100;relayFull+=Number(crosses);pending.set(r.recipientId,{wave,index:i});traces.push({kind:'relay',eventId:e.id,eventIndex:i,wave,round,recipientId:r.recipientId,recipientCharacterId:a.characterId,before:b.ultimateCharge??0,after:a.ultimateCharge??0,charge:r.charge,crosses100:crosses,autoQueued:false});}
 if(e.ultimate&&e.actorId?.startsWith('party:')&&pending.get(e.actorId)?.wave===wave){allyUltAfterRelay++;traces.push({kind:'later-ultimate',eventId:e.id,eventIndex:i,wave,round,actorId:e.actorId,earlierRelayIndex:pending.get(e.actorId)!.index,claim:'Observed later ultimate, not proof all of it was caused by relay'});pending.delete(e.actorId);}
 if(e.unitsAfter)previous=units;
}return{jamUses,jamExtended,diagnosisUses,exposureApplied,relayGrants,relayCharge,relayFull,allyUltAfterRelay,traces};}
