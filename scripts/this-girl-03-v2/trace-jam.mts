/** Actual mark application and actual consumed ordinary attacks, never hypothetical prevented HP. */
export function traceJam(events:any[]){let previous=new Map<string,any>();let jamUses=0,jamExtended=0,diagnosisUses=0,dampeningApplied=0,softenedAttacks=0,softenedHpDamage=0,softenedAbsorbed=0;const traces:any[]=[];
for(let i=0;i<events.length;i++){const e=events[i],parts=e.id?.match(/:w(\d+):r(\d+):/),wave=Number(parts?.[1]??-1),round=Number(parts?.[2]??-1);const units=new Map<string,any>((e.unitsAfter??[]).map(u=>[u.uid,u]));
if(e.actorId==='party:tikka'&&e.skillId==='jam-14'&&e.actionSelection){jamUses++;diagnosisUses+=Number(e.text.includes('故障診断'));for(const id of e.targetIds??[]){const b=previous.get(id),a=units.get(id);if(!b||!a)throw Error('Missing jam snapshots');const extended=Object.keys(a.cooldowns).filter(k=>a.cooldowns[k]>(b.cooldowns[k]??0));jamExtended+=extended.length;const marked=!!a.jamDampening&&JSON.stringify(a.jamDampening)!==JSON.stringify(b.jamDampening);dampeningApplied+=Number(marked);traces.push({kind:'jam',eventId:e.id,eventIndex:i,wave,round,targetId:id,targetCharacterId:a.characterId,extendedSkillIds:extended,cooldownsBefore:b.cooldowns,cooldownsAfter:a.cooldowns,markApplied:marked,mark:a.jamDampening,actorGaugeBefore:previous.get(e.actorId)?.ultimateCharge??0,actorGaugeAfter:units.get(e.actorId)?.ultimateCharge??0});}}
if(e.jamDampenedPercent){const b=previous.get(e.actorId),a=units.get(e.actorId);if(e.skillId||e.ultimate||e.bossStrike||e.bitAction||!b?.jamDampening||a?.jamDampening)throw Error('Invalid dampening event');softenedAttacks++;softenedHpDamage+=e.amount??0;softenedAbsorbed+=e.absorbed??0;traces.push({kind:'softened-attack',eventId:e.id,eventIndex:i,wave,round,actorId:e.actorId,percent:e.jamDampenedPercent,targetIds:e.targetIds,actualHpDamage:e.amount??0,actualAbsorbed:e.absorbed??0,targetsBefore:(e.targetIds??[]).map(id=>previous.get(id)),targetsAfter:(e.targetIds??[]).map(id=>units.get(id))});}
if(e.unitsAfter)previous=units;
}return{jamUses,jamExtended,diagnosisUses,dampeningApplied,softenedAttacks,softenedHpDamage,softenedAbsorbed,traces};}
