import{readFileSync,writeFileSync}from'node:fs';import{gunzipSync}from'node:zlib';import{run}from'./policy.mts';import{setMode,resetMode}from'./modes.mts';
const R='artifacts/this-girl-03-v2/research',id='ivory-tower-010-T4-F2',data=JSON.parse(gunzipSync(readFileSync(R+'/confirmation/'+id+'.json.gz')).toString()),i=data.arms.C.rows.findIndex((c,i)=>!c.win&&data.arms.X.rows[i].win);if(i<0)throw Error('No eligible real disagreement');const seed=data.arms.C.rows[i].seed,rows:any={};
for(const[arm,mode]of[['C','after'],['X','before']]as const){setMode(mode);const r=run(data.arms.C.config,seed,true,data.spec.stage);rows[arm]={win:r.win,pots:r.pots,rounds:r.rounds,actions:r.events.filter(e=>e.actionSelection&&e.actorId?.startsWith('party:')).map(e=>({key:e.id.match(/:w\d+:r\d+:/)?.[0]+e.actorId,actor:e.actorId,skillId:e.skillId,ultimate:!!e.ultimate,text:e.text,amount:e.amount}))};}resetMode();const diffs=rows.C.actions.filter(c=>{const x=rows.X.actions.find(x=>x.key===c.key);return x&&(c.skillId!==x.skillId||c.ultimate!==x.ultimate);}).slice(0,8).map(c=>({C:c,X:rows.X.actions.find(x=>x.key===c.key)}));writeFileSync(R+'/action-divergence-diagnosis.json',JSON.stringify({developmentOnly:true,sourceRevision:'tikka-research-v3',seed,caseId:id,results:rows,differences:diffs,note:'A concrete observed divergence, not a population proof or sole causal pathway.'},null,2));console.log(JSON.stringify(diffs.slice(0,3),null,2));
