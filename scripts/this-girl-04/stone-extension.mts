import{readFileSync,writeFileSync,mkdirSync}from'node:fs';import{createHash}from'node:crypto';import{gzipSync}from'node:zlib';import{execFileSync}from'node:child_process';import{run}from'./policy.mts';
const O='artifacts/this-girl-04/research',p=O+'/stone-extension-lock.json',sha=(p:string)=>createHash('sha256').update(readFileSync(p)).digest('hex');
if(process.argv.includes('--lock')){const primary=JSON.parse(readFileSync(O+'/confirmation-lock.json','utf8'));const cases=['kuzuha-awakening-T6-F2','ivory-tower-010-T6-F2'].map(id=>{const spec=primary.cases.find(c=>c.id===id);const m=spec.arms.M.config;const h={...m,gems:m.gems.map((g:any,i:number)=>['seris-awakened','lisette-awakened'].includes(m.party[i])?null:g)};return{id,stage:spec.stage,arms:{M:m,E:{...m,command:false,commandMode:'never'},H:h,HE:{...h,command:false,commandMode:'never'}}};});const lock={sourceCommit:execFileSync('git',['rev-parse','HEAD'],{encoding:'utf8'}).trim(),primaryLockSha256:sha(O+'/confirmation-lock.json'),codeSha256:sha('scripts/this-girl-04/stone-extension.mts'),policySha256:sha('scripts/this-girl-04/policy.mts'),designedAfterPrimary:true,reason:'Primary G arm filled empty slots, but selected mainM has no empty slots. Secondary question removes follower stones; new independent confirmation seeds, no retuning primary.',cases,seeds:Array.from({length:256},(_,i)=>createHash('sha256').update('STILLVEIL:this-girl-04:stone-extension:v1:'+i).digest().readUInt32LE(0))};writeFileSync(p,JSON.stringify(lock,null,2));console.log('STONE LOCK',sha(p));}
