import{readFileSync,writeFileSync,readdirSync}from'node:fs';import{createHash}from'node:crypto';import{gzipSync,gunzipSync}from'node:zlib';import{run,type Config}from'./policy.mts';
const seed=(n:number)=>createHash('sha256').update('STILLVEIL:this-girl-04:selection:v1:'+n).digest().readUInt32LE(0);const O='artifacts/this-girl-04/research/search';const files=readdirSync(O).filter(n=>n.endsWith('.json.gz'));if(files.length!==12)throw Error('Wait for all development cases');
const fast=(a:any,b:any)=>b.wins-a.wins||a.meanCappedRounds-b.meanCappedRounds||a.meanPots-b.meanPots||b.fourAliveWins-a.fourAliveWins;const safe=(a:any,b:any)=>b.wins-a.wins||b.fourAliveWins-a.fourAliveWins||a.meanPots-b.meanPots||a.meanCappedRounds-b.meanCappedRounds;const frugal=(a:any,b:any)=>b.wins-a.wins||a.meanPots-b.meanPots||a.meanCappedRounds-b.meanCappedRounds||b.fourAliveWins-a.fourAliveWins;
for(const f of files){const d=JSON.parse(gunzipSync(readFileSync(O+'/'+f)).toString());for(const item of d.results){const selected:any[]=[];for(const rank of[fast,safe,frugal]){const x=[...item.development].sort(rank).find(x=>!selected.some(y=>JSON.stringify(y.config)===JSON.stringify(x.config)));if(x)selected.push(x);}while(selected.length<3)selected.push([...item.development].sort(fast).find(x=>!selected.some(y=>JSON.stringify(y.config)===JSON.stringify(x.config))));item.selection=selected.map(x=>{const rows=Array.from({length:16},(_,i)=>{const r=run(x.config,seed(i),false,d.spec.stage);return{seed:seed(i),win:r.win,rounds:r.rounds,cappedRounds:r.win?r.rounds:120,pots:r.pots,survivors:r.survivors};});return{config:x.config,rows,wins:rows.filter(r=>r.win).length,meanCappedRounds:rows.reduce((s,r)=>s+r.cappedRounds,0)/16,meanPots:rows.reduce((s,r)=>s+r.pots,0)/16,fourAliveWins:rows.filter(r=>r.win&&r.survivors===4).length};});item.best=[...item.selection].sort(fast)[0];item.frugal=[...item.selection].sort(frugal)[0];item.safe=[...item.selection].sort(safe)[0];}
 const order=[...d.results].sort((a,b)=>fast(a.best,b.best));d.bestKnown=order[0].healer;d.bestAlternative=order.find(r=>r.healer!=='tikka').healer;d.selectionRevision='v2:3 development shortlists fast/safe/frugal, equal3x16 selection rows for all16 candidate forms. No heldout seen.';writeFileSync(O+'/'+f.replace('.json.gz','.diverse.json.gz'),gzipSync(JSON.stringify(d)));console.log(d.spec.id,'M',d.results.find(x=>x.healer==='tikka').best.wins,'A',d.bestAlternative);}
