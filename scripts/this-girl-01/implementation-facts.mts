import{content}from'./before-policy.mts';import{baseStats,leaderBonus}from'../../artifacts/this-girl-01/baseline/src/domain/engine';import{ultimateFor}from'../../src/domain/ultimates';import{GEM_DEFINITIONS,TIER_RANGES,gemPowerMultiplier,dungeonGemFamily,dungeonGemLootProfile,supportedGemTraits}from'../../src/domain/memory-gems';import{OUT,write,sha}from'./study-io.mts';
const target=content.characters.find(c=>c.id==='mireille')!;
const character=(c:any)=>({id:c.id,name:c.name,rarity:c.rarity,role:c.role,strength:c.strength,statsWithoutLeader:baseStats(c),leaderBonus:leaderBonus(c),leaderEffect:c.leaderEffect,skills:c.skillIds.map((id:string)=>content.skills.find(s=>s.id===id)),ultimate:ultimateFor(c),origin:c.origin});
