import{OUT,read,write,sha,summary}from'./study-io.mts';import{key}from'./study-space.mts';import*as lib from'./after-policy.mts';import{createBattle,rng}from'../../src/domain/engine';
const lockPath=`${OUT}/confirmation-lock.json`,expected=process.argv[2],task=process.argv[3];if(!expected||sha(lockPath)!==expected)throw Error('Reviewed lock SHA required');const lock=read(lockPath);for(const[p,s]of Object.entries(lock.sources))if(sha(p)!==s)throw Error('Source changed since lock '+p);
const contract=lib.content.characters.find(c=>c.id==='mireille')!.skillOverrides!['barrier-18'].barrierReturn!;
function evaluate(config:any,stage:string,panelStart:number,scenario:any={},payout=100){const cap=lib.content.dungeons.find(d=>d.id===stage)!.waves.length*40;const rows=lock.seedMap.filter((s:any)=>s.logical>=panelStart&&s.logical<panelStart+256).map((s:any)=>{
 const b=createBattle(lib.content,config.party,config.leader,stage,5,s.departureSeed,'run-1000-'+s.departureSeed);b.memoryGems=Object.fromEntries(config.party.flatMap((id:string,i:number)=>config.gems[i]?[[id,{...config.gems[i],id:'slot-'+i}]]:[]));
 const done=new Set<string>();const transform=(battle:any)=>{for(const u of battle.units){if(done.has(u.uid))continue;done.add(u.uid);const rarity=lib.content.characters.find(c=>c.id===u.characterId)!.rarity;const percent=u.side==='party'&&['SSR','XR'].includes(rarity)?scenario.high??0:u.side==='enemy'?scenario.enemy??0:0;for(const k of u.side==='enemy'?['maxHp','attack']:['maxHp','attack','defense'])if(percent)u[k]=Math.max(1,Math.round(u[k]*(100+percent)/100));u.hp=u.maxHp;}};
 transform(b);b.initialUnits=structuredClone(b.units);const old=contract.payoutPercent;contract.payoutPercent=payout;let r;try{r=lib.play(config,b,false,Infinity,transform);}finally{contract.payoutPercent=old;}
 return{seed:s.logical,applicationSeed:s.applicationSeed,departureSeed:s.departureSeed,win:r.win,rounds:r.rounds,cappedRounds:r.win?r.rounds:cap,potionsUsed:r.pots,survivors:r.survivors,telemetry:r.telemetry};});if(rows.length!==256)throw Error('Bad panel');return summary(config,key(config),rows);}
if(task==='growth'){
 for(const g of lock.growth){const low=evaluate(g.low,g.stage,930001),high=evaluate(g.high,g.stage,930001);write(`${OUT}/growth/${g.id.replaceAll(':','_')}.json.gz`,{...g,lockSha:expected,low,high});console.log('GROWTH',g.id,low.wins,high.wins);}
}else if(task==='stress'){
 for(const c of lock.cases.filter((c:any)=>c.tier===6)){const results=[];for(const scenario of[{id:'zero',high:0,enemy:0},{id:'high25',high:25},{id:'high50',high:50},{id:'enemyMinus10',enemy:-10},{id:'enemyPlus10',enemy:10}]){const arms:any={};for(const name of ['A','C','E'])arms[name]=evaluate(c.arms[name].config,c.stage,950001,scenario,name==='E'?0:100);results.push({scenario,arms});console.log('STRESS',c.id,scenario.id);}
 write(`${OUT}/stress/${c.id}.json.gz`,{id:c.id,lockSha:expected,status:'frozen-build unit-stat robustness only; no future-adoption proof',definition:'SSR/XR party HP/ATK/DEF multiplied once, speed/LS unchanged; enemy HP/ATK multiplied once each wave, defense unchanged',results});}
}else if(task==='hidden'){
 const stages=['lunette-awakening','ivory-tower-025','moonshield-rehearsal'];for(const stage of stages)for(const coreId of ['F1','F4']){const baseStage=stage.startsWith('ivory')?'ivory-tower-010':'kuzuha-awakening';const c=lock.cases.find((c:any)=>c.stage===baseStage&&c.tier===6&&c.coreId===coreId);const arms:any={};for(const name of ['A','C','E'])arms[name]=evaluate(c.arms[name].config,stage,960001,{},name==='E'?0:100);write(`${OUT}/hidden/${stage}-${coreId}.json.gz`,{stage,coreId,sourceCase:c.id,lockSha:expected,status:'fixed transfer; no tuning or primary certification',arms});console.log('HIDDEN',stage,coreId);}
}else if(task==='noel'){
 for(const n of lock.noel){const arms:any={};for(const mode of n.modes){const c={...structuredClone(n.commander),command:mode!=='never',commandMode:mode};arms[mode]=evaluate(c,n.stage,930001);}arms.sakuyaLeader=evaluate({...structuredClone(n.sakuya),command:false,commandMode:'never'},n.stage,930001);write(`${OUT}/noel/${n.stage}.json.gz`,{...n,lockSha:expected,arms,status:'supplementary only; exact commander build three-policy comparison and separate leader opportunity comparison'});console.log('NOEL',n.stage);}
}else throw Error('Unknown task');
for(const[p,s]of Object.entries(lock.sources))if(sha(p)!==s)throw Error('Source changed during supplementary execution '+p);
