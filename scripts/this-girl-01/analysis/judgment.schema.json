{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stillveil:this-girl-01:judgment:v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "finalized",
    "sourceLockSha256",
    "evidenceRefs",
    "scope",
    "overall",
    "gates",
    "verifiedClaims",
    "unverifiedClaims",
    "subject",
    "nextEpisode"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "finalized": {
      "const": true
    },
    "sourceLockSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "role": {
            "type": "string"
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "stages",
        "tiers",
        "cores",
        "seedPanel",
        "seedCount",
        "searchLimit",
        "ownership",
        "publicAvailability"
      ]
    },
    "overall": {
      "type": "object",
      "required": [
        "status",
        "certified",
        "label",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "research",
            "verified-scoped"
          ]
        },
        "certified": {
          "type": "boolean"
        },
        "label": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "research"
              }
            }
          },
          "then": {
            "properties": {
              "certified": {
                "const": false
              },
              "label": {
                "const": "研究中"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "verified-scoped"
              }
            }
          },
          "then": {
            "properties": {
              "certified": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "scope",
          "evidenceRefs"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "verified",
              "not-established",
              "failed",
              "unverified"
            ]
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "role": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "verifiedClaims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "scope",
          "evidenceRefs"
        ],
        "properties": {
          "evidenceRefs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "role": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "unverifiedClaims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "reason"
        ]
      }
    },
    "subject": {
      "type": "object",
      "required": [
        "characterId",
        "seriesId",
        "buildName",
        "provisional"
      ],
      "properties": {
        "characterId": {
          "const": "mireille"
        },
        "seriesId": {
          "const": "BD009"
        },
        "provisional": {
          "const": true
        }
      }
    },
    "nextEpisode": {
      "type": "object",
      "required": [
        "characterId",
        "seriesId",
        "status",
        "certified"
      ],
      "properties": {
        "characterId": {
          "const": "miette"
        },
        "seriesId": {
          "const": "BD019"
        },
        "status": {
          "const": "unverified"
        },
        "certified": {
          "const": false
        }
      }
    }
  }
}
