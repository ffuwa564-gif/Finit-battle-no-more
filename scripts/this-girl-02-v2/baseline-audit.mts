import{readFileSync,writeFileSync}from'node:fs';import{gunzipSync}from'node:zlib';import{createHash}from'node:crypto';import{content,run}from'./policy.mts';
if(content.appVersion!=='1.12.0')throw Error('Public flag required');const lock=JSON.parse(readFileSync('artifacts/this-girl-02/research/confirmation-lock.json','utf8'));const checks=[];for(const s of lock.cases){const old=JSON.parse(gunzipSync(readFileSync('artifacts/this-girl-02/research/confirmation/'+s.id+'.json.gz')).toString());for(const arm of['M','A'])for(const expected of old.arms[arm].rows.slice(0,3)){const r=run(s.arms[arm].config,expected.seed,false,s.stage);const actual={win:r.win,rounds:r.rounds,pots:r.pots,survivors:r.survivors};const passed=Object.entries(actual).every(([k,v])=>expected[k]===v);checks.push({case:s.id,arm,seed:expected.seed,expected:Object.fromEntries(Object.keys(actual).map(k=>[k,expected[k]])),actual,passed});if(!passed)throw Error('Legacy engine regression '+JSON.stringify(checks.at(-1)));}}
writeFileSync('artifacts/this-girl-02-v2/research/baseline-equivalence.json',JSON.stringify({passed:true,scope:'72 genuine public-engine comparisons against frozen episode02 results; not a proof for all possible battles.',checks,codeSha256:createHash('sha256').update(readFileSync('scripts/this-girl-02-v2/baseline-audit.mts')).digest('hex')},null,2));console.log('PUBLIC BASELINE EXACT',checks.length);
