import{readFileSync,writeFileSync,existsSync}from'node:fs';import{gunzipSync}from'node:zlib';import{createHash}from'node:crypto';import{traceMend}from'./trace-mend.mts';
const O='artifacts/this-girl-02-v2';const sha=(p:string)=>createHash('sha256').update(readFileSync(p)).digest('hex');const result:any={passed:true,scope:'Actual application event snapshots. Resource amounts are not painted into the native HUD. Expired thread and active barrier are separate.'};
for(const id of['reference','miette']){const pp=O+'/proofs/'+id+'.json.gz',p=JSON.parse(gunzipSync(readFileSync(pp)).toString());const history=p.groups.filter(g=>g.kind==='round').map(g=>({type:'round',wave:g.wave,round:g.round,unitsBefore:g.before.battle.units}));const t=traceMend(p.events,history);const selected=id==='reference'?t.traces.find(t=>t.hpHealed>0):t.traces.find(t=>t.borrowed>0&&t.beforeBarrier===0)??t.traces.find(t=>t.borrowed>0);if(!selected)throw Error('No genuine witness '+id);const at=p.events.findIndex(e=>e.id===selected.eventId),e=p.events[at],parts=e.id.match(/:w(\d+):r(\d+):/)!;let before=history.find(h=>h.wave===Number(parts[1])&&h.round===Number(parts[2])).unitsBefore;for(const event of p.events.slice(0,at)){if(event.id.includes(':w'+parts[1]+':r'+parts[2]+':')&&event.unitsAfter)before=event.unitsAfter;}
const donors=selected.donors.map(d=>{const u=before.find(u=>u.uid===d.unitId),a=e.unitsAfter.find(u=>u.uid===d.unitId);return{...d,activeBarrierBefore:(u.barrierUntil??-1)>=selected.round?u.barrier??0:0,activeBarrierAfter:(a.barrierUntil??-1)>=selected.round?a.barrier??0:0};});const mp=O+'/capture/'+id+'.json';const meta=existsSync(mp)?JSON.parse(readFileSync(mp,'utf8')):null;result[id]={...selected,donors,allTraces:t.traces,proofSha256:sha(pp),sourceFrame:meta?.battleEvents.find(x=>x.event.id===e.id)?.sourceFrame??null,sourceSha256:meta?sha(O+'/capture/'+id+'.mov'):null,metadataSha256:meta?sha(mp):null,party:p.config.party,beforeUnits:before,afterUnits:e.unitsAfter};}
if(result.miette.donors.some(d=>!d.isRecipient&&d.source==='barrier'))throw Error('Unexpected active ally shield spending');writeFileSync(O+'/research/mechanism-miette.json',JSON.stringify(result,null,2));console.log('SELECTED',JSON.stringify({reference:result.reference.eventId,after:result.miette.eventId,healed:result.miette.hpHealed,spent:result.miette.resourceSpent,donors:result.miette.donors},null,2));
