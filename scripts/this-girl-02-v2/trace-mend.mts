import type{BattleEvent,Unit}from'../../src/domain/types';
export function traceMend(events:BattleEvent[],history:any[]=[]){let previous:Unit[]=[];let seenRound='';const traces:any[]=[];let directHeals=0;for(const e of events){const key=e.id.match(/:w(\d+):r(\d+):/);if(key&&seenRound!==key[0]){seenRound=key[0];const start=history.find(h=>h.type==='round'&&h.wave===Number(key[1])&&h.round===Number(key[2]));if(start?.unitsBefore)previous=start.unitsBefore;}if(e.actorId==='party:miette'&&e.skillId==='heal-18')directHeals++;if(e.actorId==='party:miette'&&e.skillId==='barrier-mend-18'){const round=Number(e.id.match(/:r(\d+):/)?.[1]);const targetId=e.targetIds?.[0],old=previous.find(u=>u.uid===targetId),target=e.unitsAfter?.find(u=>u.uid===targetId);if(!old||!target||!Number.isInteger(round))throw Error('Missing real mend before/after');const donors=previous.filter(u=>u.side===old.side&&u.hp>0).flatMap(u=>{const after=e.unitsAfter!.find(v=>v.uid===u.uid)!;const active=(u.barrierUntil??-1)>=round?u.barrier??0:0;const afterActive=(after.barrierUntil??-1)>=round?after.barrier??0:0;const shieldSpent=Math.max(0,active-afterActive);const threadBefore=(u.mendThread?.until??-1)>=round?u.mendThread!.amount:0;const threadAfter=(after.mendThread?.until??-1)>=round?after.mendThread!.amount:0;const threadSpent=Math.max(0,threadBefore-threadAfter);return[...(shieldSpent>0?[{unitId:u.uid,characterId:u.characterId,barrierBefore:active,barrierAfter:afterActive,spent:shieldSpent,source:'barrier',isRecipient:u.uid===targetId}]:[]),...(threadSpent>0?[{unitId:u.uid,characterId:u.characterId,threadBefore,threadAfter,spent:threadSpent,source:'thread',isRecipient:u.uid===targetId}]:[])];});const spent=donors.reduce((s,d)=>s+d.spent,0);if(target.hp-old.hp!==e.amount)throw Error('Mend HP log differs');traces.push({eventId:e.id,actorId:e.actorId,targetId,targetCharacterId:old.characterId,beforeHp:old.hp,afterHp:target.hp,maxHp:old.maxHp,beforeBarrier:(old.barrierUntil??-1)>=round?old.barrier??0:0,afterBarrier:target.barrier??0,resourceSpent:spent,barrierSpent:donors.filter(d=>d.source==='barrier').reduce((x,d)=>x+d.spent,0),hpHealed:e.amount??0,borrowed:donors.filter(d=>!d.isRecipient).reduce((s,d)=>s+d.spent,0),donors,round});}if(e.unitsAfter)previous=e.unitsAfter;}
return{traces,directHeals,mendUses:traces.length,mendHealing:traces.reduce((s,t)=>s+t.hpHealed,0),mendResourceSpent:traces.reduce((s,t)=>s+t.resourceSpent,0),mendBarrierSpent:traces.reduce((s,t)=>s+t.donors.filter(d=>d.source==='barrier').reduce((x,d)=>x+d.spent,0),0),mendThreadSpent:traces.reduce((s,t)=>s+t.donors.filter(d=>d.source==='thread').reduce((x,d)=>x+d.spent,0),0),borrowed:traces.reduce((s,t)=>s+t.borrowed,0),borrowUses:traces.filter(t=>t.borrowed>0).length,unshieldedHeals:traces.filter(t=>t.borrowed>0&&t.beforeBarrier===0&&t.hpHealed>0).length};}
