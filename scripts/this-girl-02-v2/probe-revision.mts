import{readFileSync,writeFileSync}from'node:fs';import{createHash}from'node:crypto';import{run}from'./policy.mts';import{setMode,resetMode}from'./modes.mts';
const old=JSON.parse(readFileSync('artifacts/this-girl-02/research/confirmation-lock.json','utf8'));const out=[];for(const s of old.cases){const sums:any={};for(const mode of['before','after']as const){setMode(mode);const rows=Array.from({length:12},(_,i)=>{const seed=createHash('sha256').update('STILLVEIL:this-girl-02-v2:development:v1:'+i).digest().readUInt32LE(0);const r=run(s.arms.M.config,seed,false,s.stage);return{win:r.win,pots:r.pots,rounds:r.win?r.rounds:120,alive:r.survivors};});sums[mode]={wins:rows.filter(r=>r.win).length,pots:rows.reduce((s,r)=>s+r.pots,0)/rows.length,rounds:rows.reduce((s,r)=>s+r.rounds,0)/rows.length,allAlive:rows.filter(r=>r.win&&r.alive===4).length};}resetMode();out.push({id:s.id,...sums});console.log(s.id,sums);}
writeFileSync('artifacts/this-girl-02-v2/research/development-probe.json',JSON.stringify({developmentOnly:true,scope:'Old selected configs, new development inputs, not new confirmation or fair reoptimized alternatives.',cases:out},null,2));
