import{createHash}from'node:crypto';import{writeFileSync,mkdirSync}from'node:fs';import{gzipSync}from'node:zlib';import{content,run,gem,valid,type Config}from'./policy.mts';
import{setMode,resetMode}from'./modes.mts';
const O='artifacts/this-girl-02-v2/research';mkdirSync(O+'/search',{recursive:true});const ci=Number(process.argv[2]);const cores=[['seris-awakened','athena','astraea'],['lunette-awakened','liora-awakened','asteria']];
const cases=cores.flatMap((core,i)=>['ivory-tower-010','kuzuha-awakening'].flatMap(stage=>[3,4,6].map(tier=>({id:`${stage}-T${tier}-F${i+1}`,core,tier,stage}))));const spec=cases[ci];if(!spec)throw Error('Bad case');
const seed=(domain:string,n:number)=>createHash('sha256').update('STILLVEIL:this-girl-02-v2:'+domain+':v1:'+n).digest().readUInt32LE(0);
function configs(healer:string):Config[]{const result:Config[]=[];for(let pattern=0;pattern<3;pattern++)for(const lead of[spec.core[1],healer])for(let tactic=0;tactic<3;tactic++){
 const party=tactic===2?[healer,...spec.core]:[...spec.core,healer];const secondary=content.skills.find(s=>s.id===content.characters.find(c=>c.id===healer)!.skillIds[1])!.template;
 const gems=party.map((id,i)=>{const def=pattern===1&&id===spec.core[1]?'pale-ward':pattern===2&&id===healer?'hollow-lantern':'echo-shard';return gem(def,spec.tier,def==='echo-shard'&&i%2?'mercy':'bulwark',spec.tier);});
 const cfg:Config={party,leader:lead,gems,policy:tactic===1?1:0,...(tactic===2?{prefer:[secondary]}:{})};if(!valid(cfg))throw Error('Invalid config '+JSON.stringify({healer,pattern,tactic,cfg}));result.push(cfg);
}return result;}
function evaluate(config:Config,domain:string,count:number){const rows=Array.from({length:count},(_,i)=>{const r=run(config,seed(domain,i),false,spec.stage);return{seed:seed(domain,i),win:r.win,rounds:r.rounds,cappedRounds:r.win?r.rounds:120,pots:r.pots,survivors:r.survivors};});const wins=rows.filter(r=>r.win).length;return{config,rows,wins,meanCappedRounds:rows.reduce((s,r)=>s+r.cappedRounds,0)/count,meanPots:rows.reduce((s,r)=>s+r.pots,0)/count,fourAliveWins:rows.filter(r=>r.win&&r.survivors===4).length};}
const rank=(a:any,b:any)=>b.wins-a.wins||a.meanCappedRounds-b.meanCappedRounds||a.meanPots-b.meanPots||b.fourAliveWins-a.fourAliveWins;
const healers=content.characters.filter(c=>c.role==='healer'&&c.published&&!spec.core.includes(c.id)).map(c=>c.id);const results=[];const start=Date.now();
for(const healer of [...healers,'miette-before']){setMode(healer==='miette-before'?'before':'after');const characterId=healer==='miette-before'?'miette':healer;const development=configs(characterId).map(c=>evaluate(c,'development',8)).sort(rank);const selected=development.slice(0,3).map(x=>evaluate(x.config,'selection',16)).sort(rank);results.push({healer,candidateCount:development.length,development,selection:selected,best:selected[0]});}
resetMode();const ordered=[...results].sort((a,b)=>rank(a.best,b.best));const out={spec,sourceGameCommit:process.env.GAME_COMMIT,policySourceSha256:createHash('sha256').update(await(await import('node:fs/promises')).readFile('scripts/this-girl-02-v2/policy.mts')).digest('hex'),milliseconds:Date.now()-start,results,bestKnown:ordered[0].healer,bestAlternative:ordered.find(r=>!['miette','miette-before'].includes(r.healer))!.healer,scope:'Finite symmetric18-candidate search per healer.8 development seeds select3,16 disjoint selection seeds choose1. No heldout data used.'};writeFileSync(O+'/search/'+spec.id+'.json.gz',gzipSync(JSON.stringify(out)));console.log(spec.id,'best',out.bestKnown,'alt',out.bestAlternative,'ms',out.milliseconds);
