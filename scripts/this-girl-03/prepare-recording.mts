import{readFileSync,writeFileSync,mkdirSync}from'node:fs';import{gunzipSync}from'node:zlib';import{createHash}from'node:crypto';import{execFileSync}from'node:child_process';import{prepare}from'./capture/prepare-proof.mts';
const O='artifacts/this-girl-03';const lp=O+'/research/confirmation-lock.json',lock=JSON.parse(readFileSync(lp,'utf8'));const sha=(p:string)=>createHash('sha256').update(readFileSync(p)).digest('hex');let chosen:any;
for(const id of['ivory-tower-010-T6-F1','lunette-awakening-T6-F1','ivory-tower-010-T4-F1']){const spec=lock.cases.find(c=>c.id===id);const d=JSON.parse(gunzipSync(readFileSync(O+'/research/confirmation/'+id+'.json.gz')).toString());if(d.lockSha!==sha(lp))throw Error('Different confirmation lock');for(let i=0;i<256;i++){const a=d.arms.A.rows[i],m=d.arms.M.rows[i];if(a.seed!==m.seed)throw Error('Unpaired rows');if(a.win&&m.win&&m.jamUses>0&&m.jamExtended>0){chosen={caseId:id,stageId:spec.stage,logicalSeed:m.logical,applicationSeed:m.seed,arms:{A:spec.arms.A,M:spec.arms.M},rowA:a,rowM:m,selectionPolicy:lock.recordingSelection};break;}}if(chosen)break;}
if(!chosen)throw Error('Predeclared demonstration witness not found; report limitation before choosing an alternate film');mkdirSync(O+'/proofs',{recursive:true});writeFileSync(O+'/research/recording-selection.json',JSON.stringify(chosen,null,2));const head=execFileSync('git',['rev-parse','HEAD'],{encoding:'utf8'}).trim();
for(const[id,key,arm]of[['reference','A','A'],['tikka','M','C']]as const){const spec={id,caseId:chosen.caseId,arm,model:'after' as const,preflight:false,stageId:chosen.stageId,applicationSeed:chosen.applicationSeed,logicalSeed:chosen.logicalSeed,config:chosen.arms[key].config,sourceGameCommit:head,researchLockCommit:lock.sourceGameCommit,researchLockSha256:sha(lp),disclosure:'Public1.12 mechanics; all-owned hypothetical research fixture, including currently unobtainable XR. No unpublished character ability.'};writeFileSync(O+'/proofs/spec-'+id+'.json',JSON.stringify(spec,null,2));const p=await prepare(spec);const r=key==='A'?chosen.rowA:chosen.rowM;if(p.nativeSummary.win!==r.win||p.nativeSummary.rounds!==r.rounds||p.nativeSummary.pots!==r.pots||p.nativeSummary.survivors!==r.survivors)throw Error('Native selected row differs');}
console.log('RECORDED CASE SPEC',chosen.caseId,chosen.logicalSeed,chosen.rowA,chosen.rowM);
