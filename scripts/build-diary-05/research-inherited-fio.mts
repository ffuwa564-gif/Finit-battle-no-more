b.strategy='survival';b.crystalRole=low.hp<low.maxHp*.75?'healer':'attacker';const enemies=b.units.filter((u:any)=>u.side==='enemy'&&u.hp>0),boss=enemies.find((u:any)=>u.boss)??enemies[0];b.focusTargetId=(opt.targetBell?enemies.find((u:any)=>!u.boss)??boss:boss).uid;for(const u of alive)if(u.characterId!==ids[0]&&u.ultimateCharge===100)u.ultimateQueued=true;
const pilot=alive.find((u:any)=>u.characterId===ids[0]);if(pilot){const opts=partyOrderOptions(pilot,b,content).filter(o=>!o.disabled);const box=opts.find(o=>o.order?.kind==='skill'&&o.order.skillId===SUPPLY),overflow=opts.find(o=>o.order?.kind==='skill'&&o.order.skillId==='scout-fio-overflow'),full=opts.find(o=>o.order?.kind==='skill'&&o.order.skillId==='heal-17')??opts.find(o=>['heal','mend_pair'].includes(o.template));const seedStone=opts.find(o=>o.id.startsWith('skill:memory:white-flower-seed:'));const ult=opts.find(o=>o.id==='ultimate');const ownBox=b.researchSupplyBoxes?.[pilot.uid];const couldStore=low.maxHp-low.hp<Math.floor(pilot.attack*47/40*(b.crystalRole==='healer'?1.2:1));const cycle=b.round%4;const naive=['schedule','early-guard'].includes(opt.policy);const guardCycle=opt.policy==='early-guard'?2:3;const seedCycle=opt.policy==='early-guard'?3:2;if(content.characters.find(c=>c.id===pilot.characterId)!.role==='tank'&&opt.policy!=='auto-pilot'){const ownGuard=opts.find(o=>o.template==='guard'&&o.order?.kind==='skill');const damage=opts.find(o=>o.order?.kind==='skill'&&['attack','pierce','dawn','shatter'].includes(o.template));const cleanse=opts.find(o=>o.template==='cleanse');b.partyOrder=(opt.frontlineCleanse&&cleanse&&alive.some((u:any)=>u.ailments)?cleanse.order:b.round===1?ownGuard?.order:cycle===3||cycle===0?{kind:'guard'}:cycle===2&&seedStone?seedStone.order:ult?.order??damage?.order)??undefined;}else if(naive){b.partyOrder=(cycle===1?(box??overflow)?.order:cycle===guardCycle?{kind:'guard'}:cycle===seedCycle?seedStone?.order:ult?.order??full?.order)??{kind:'attack'};}else{b.partyOrder=(cycle===3&&pilot.whiteFlower?{kind:'guard'}:low.hp<low.maxHp*.55?(ult?.order??full?.order):box&&couldStore&&(!ownBox||ownBox.amount<=0||ownBox.until<b.round)?box.order:ult&&alive.some((u:any)=>u.hp<u.maxHp*.85)?ult.order:cycle===2&&seedStone?seedStone.order:overflow&&couldStore?overflow.order:low.hp<low.maxHp*.95?full?.order:undefined)??undefined;}}
