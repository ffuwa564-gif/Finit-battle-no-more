/** Research-only general capacity care and escorted exposed-unit objective. No winner ID checks. */
export const CARE='research-elaine-returning-saucer';
export function initializeCapacity(u:any,exposure=0){if(!u.researchCapacity)u.researchCapacity={originalMaxHp:u.maxHp,exposure};}
export function capacitySnapshot(b:any){return Object.fromEntries(b.units.filter((u:any)=>u.side==='party'&&u.researchCapacity).map((u:any)=>[u.uid,{originalMaxHp:u.researchCapacity.originalMaxHp,maxHp:u.maxHp,hp:u.hp,exposure:u.researchCapacity.exposure}]));}
export function careSkill(b:any,u:any,id:string){if(id!==CARE||u.side!=='party'||u.hp<=0)return;const eligible=b.units.filter((x:any)=>x.side==='party'&&x.hp>0&&x.researchCapacity&&x.maxHp<x.researchCapacity.originalMaxHp);const target=eligible.find((x:any)=>x.uid===b.researchCareTarget)??eligible.sort((a:any,c:any)=>a.maxHp/a.researchCapacity.originalMaxHp-c.maxHp/c.researchCapacity.originalMaxHp||a.uid.localeCompare(c.uid))[0];if(!target)return{handled:true,amount:0,targetIds:[],messages:['研究：帰還の鉢皿 — 失われた容量がなく、変化なし']};const restored=Math.min(target.researchCapacity.originalMaxHp-target.maxHp,Math.ceil(target.researchCapacity.originalMaxHp/4));target.maxHp+=restored;return{handled:true,amount:0,targetIds:[target.uid],messages:[`研究：帰還の鉢皿 — 最大HP容量${restored}を戻した（現在HPは増えない）`]};}
export function careSuggested(b:any,u:any,skills:any[]){if(u.side!=='party'||u.hp<=0)return;const skill=skills.find(s=>s.id===CARE);if(!skill)return;const target=b.units.filter((x:any)=>x.side==='party'&&x.hp>0&&x.researchCapacity&&x.researchCapacity.originalMaxHp-x.maxHp>=Math.ceil(x.researchCapacity.originalMaxHp/4)).sort((a:any,c:any)=>a.maxHp/a.researchCapacity.originalMaxHp-c.maxHp/c.researchCapacity.originalMaxHp||a.uid.localeCompare(c.uid))[0];if(target)return{skill,template:skill.template,targets:[target]};}
export function escortFailed(b:any){const q=b.researchEscort;if(!q)return false;const p=b.units.filter((u:any)=>u.side==='party'&&u.researchProtected);return p.length!==q.requiredProtectedCount||p.some((u:any)=>u.hp<=0||u.maxHp<=0)||!b.units.some((u:any)=>u.side==='party'&&!u.researchNoncombatant&&u.hp>0);}
export function capacityWeather(b:any){if(!b.researchEscort)return[];const out:any[]=[];for(const u of b.units.filter((u:any)=>u.side==='party'&&u.hp>0&&u.researchCapacity?.exposure>0)){const q=u.researchCapacity,base=q.originalMaxHp;let rate=.2*q.exposure;if((u.defendingUntil??-1)>=b.round)rate*=.75;if(b.units.some((g:any)=>g.side==='party'&&g.hp>0&&g.uid!==u.uid&&g.guardTarget===u.uid&&(g.guardUntil??-1)>=b.round))rate*=.75;if(u.researchRestRound===b.round)rate*=.75;const minimum=Math.ceil(base*q.exposure/10),loss=Math.min(u.maxHp,Math.max(minimum,Math.ceil(base*rate)));u.maxHp-=loss;u.hp=Math.min(u.hp,u.maxHp);out.push({kind:'debuff',targetIds:[u.uid],text:`研究：夜露の萎れ — 最大HP容量${loss}を失った`,researchCapacityAfter:capacitySnapshot(b)});}return out;}
export function escortFinish(b:any){const q=b.researchEscort;if(!q)return[];if(escortFailed(b)){q.failed=true;return[{kind:'defeat',text:'研究：護衛失敗 — 白花または付き添う仲間を失った',researchCapacityAfter:capacitySnapshot(b)}];}if(b.round>=q.duration){q.completed=true;return[{kind:'wave',text:'研究：白花の帰還 — 12Rの護衛を終えた',researchCapacityAfter:capacitySnapshot(b)}];}return[];}
export function escortCanReward(b:any){const q=b.researchEscort;return !q||q.completed===true&&q.failed!==true&&b.round>=q.duration&&!escortFailed(b);}
