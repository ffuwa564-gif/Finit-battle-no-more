import{readFileSync,writeFileSync}from'node:fs';import{content}from'./research-native/src/content/index';import{createBattle,resolveRound,advanceReplay,usePotion,useBattleFairy,useBattleBloom,characterStats}from'./research-native/src/domain/engine';import{gem,valid}from'./research-native/scripts/diary-part3/core';import{CARE,initializeCapacity}from'./research-native/src/domain/research-elaine';import{SUPPLY}from'./research-native/src/domain/research-fio';import{REST}from'./research-native/src/domain/research-neri';import{partyOrderOptions}from'./research-native/src/domain/party-orders';const O='artifacts/build-diary-05/research';const originalElaine=[...content.characters.find(c=>c.id==='elaine')!.skillIds],originalFio=[...content.characters.find(c=>c.id==='fio')!.skillIds],originalNeri=[...content.characters.find(c=>c.id==='neri')!.skillIds];content.skills.push({id:CARE,name:'帰還の鉢皿（研究案）',template:'buff',strength:14,soundProfile:'heal'},{id:SUPPLY,name:'余り布の預かり箱（研究案）',template:'heal',strength:17,soundProfile:'heal'},{id:REST,name:'休番の札（研究案）',template:'barrier',strength:13,soundProfile:'guard'});content.characters.push({...structuredClone(content.characters.find(c=>c.id==='pale-wolf')!),id:'research-night-dew-shadow',name:'夜露の獣影',role:'area_attacker',strength:12,skillIds:['area-12','attack-12'],dialogue:{intro:'夜露は、根の届く場所を奪う。',threshold:'影は薄れても、風はまだ止まらない。',defeat:'夜がほどける。朝までは、もう少し。'}}as any);content.characters.push({...structuredClone(content.characters.find(c=>c.id==='ione')!),id:'research-whiteflower-pot',familyId:'research-whiteflower-pot',name:'療養室の白花の鉢',role:'supporter',strength:10,skillIds:[],origin:[],published:false}as any);content.dungeons.push({id:'research-whiteflower-return',name:'白花の帰還路（研究用）',subtitle:'また、咲ける場所を。',description:'12Rまで露出した白花の器と命を守る。環境で元容量20%が萎れ、guard/cover/restで軽減しても最低10%を失う。容量ケアは元の器だけを戻し、HPは別の手当。敵先殺しで通常被害は消せるが環境と護衛は続く。',artId:'pale-wolf-art',published:true,kind:'trial',towerFloor:999,bossScale:{hp:600,attack:100},waves:[[{characterId:'rese