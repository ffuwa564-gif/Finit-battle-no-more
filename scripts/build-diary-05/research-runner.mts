export function configureElaine(enabled=true){content.characters.find(c=>c.id==='elaine')!.skillIds=enabled?originalElaine.map(id=>id==='cleanse-14'?CARE:id):[...originalElaine];}
export function configurePartners(opt:any){content.characters.find(c=>c.id==='fio')!.skillIds=opt.newFio===false?[...originalFio]:originalFio.map(id=>id==='scout-fio-overflow'?SUPPLY:id);content.characters.find(c=>c.id==='neri')!.skillIds=opt.newNeri?originalNeri.map(id=>id==='scout-neri-lantern'?REST:id):[...originalNeri];}
function settle(b:any){if(b.phase==='playing'){b.cursor=b.events.length-1;return advanceReplay(b,content);}return b;}
export function trial(opt:any={},seed=1){const ids=opt.party??['elaine','fio','liora-awakened'],leader=opt.leader??ids[0],tier=opt.tier??3;configureElaine(opt.care!==false);configurePartners(opt);const gs=opt.gems??ids.map((id:string)=>gem(['liora-awakened','athena','neri'].includes(id)?'pale-ward':['fio','benzaiten','selene','selene-standard','elaine-awakened'].includes(id)?'twin-tide':'echo-shard',tier,['liora-awakened','athena','neri','fio','benzaiten','selene','selene-standard','elaine-awakened'].includes(id)?'bulwark':'mercy',tier));if(ids.length>3)throw Error('This research escort allows3 heroes plus1 protected noncombatant.');if(!valid({party:ids,leader,gems:gs}))throw Error('Invalid hero configuration');let b:any=createBattle(content,ids,leader,'research-whiteflower-return',opt.potions??5,seed,'elaine-'+seed);b.memoryGems=Object.fromEntries(ids.map((id:string,i:number)=>[id,{...gs[i],id:'slot-'+i}]));for(const u of b.units.filter((u:any)=>u.side==='party'))initializeCapacity(u,opt.exposeHeroes?1:0);const def=content.characters.find(c=>c.id==='research-whiteflower-pot')!,stats=characterStats(def,content.characters.find(c=>c.id===leader));const p:any={uid:'party:research-whiteflower-pot',characterId:def.id,side:'party',boss:false,hp:stats.hp,maxHp:stats.hp,attack:0,defense:stats.defense,speed:0,tie:0,cooldowns:{},researchNoncombatant:true,researchProtected:true};initializeCapacity(p,1);b.units.push(p);b.researchEscort={duration:12,requiredProtectedCount:1};b.initialUnits=structuredClone(b.units);if(opt.enemyAlreadyGone)b.units.filter((u:any)=>u.side==='enemy').forEach((u:any)=>u.hp=0);if(opt.prepare)opt.prepare(b);b=settle(b);const captureFixture=structuredClone(b),captureSteps:any[]=[],trace:any[]=[];let rounds=0,pots=0,fairies=0,flowers=0,restored=0,careCasts=0,careReservations=0;
function step(kind:string,after:any,command?:any){if(opt.record)captureSteps.push({kind,command,before:structuredClone(b),after:structuredClone(after)});b=settle(after);}
while(!['reward','failed'].includes(b.phase)&&rounds<40){const alive=b.units.filter((u:any)=>u.side==='party'&&u.hp>0),low=[...alive].sort((a:any,c:any)=>a.hp/a.maxHp-c.hp/c.maxHp)[0];if(!low)break;const enemies=b.units.filter((u:any)=>u.side==='enemy'&&u.hp>0);if(opt.sideActions!==false){if(low.hp<low.maxHp*.45&&b.potionsRemaining&&!b.potionUsed){step('potion',usePotion(b,low.uid),{type:'potion',unitId:low.uid});pots++;continue;}if(enemies.length&&b.fairies?.visitor){step('battleFairy',useBattleFairy(b,b.fairies.visitor.id,content),{type:'battleFairy',fairyId:b.fairies.visitor.id});fairies++;continue;}if(enemies.length&&b.blooms?.flower){step('battleBloom',useBattleBloom(b,b.blooms.flower.id,content).battle,{type:'battleBloom',bloomId:b.blooms.flower.id});flowers++;continue;}}
b.strategy='survival';b.crystalRole=low.hp<low.maxHp*.8?'healer':'attacker';b.focusTargetId=enemies[0]?.uid;for(const u of alive){const role=content.characters.find(c=>c.id===u.characterId)?.role;if(!enemies.length&&role!=='healer')delete u.ultimateQueued;else if(u.characterId!==ids[0]&&u.ultimateCharge===100&&!u.researchNoncombatant)u.ultimateQueued=true;}const pilot=alive.find((u:any)=>u.characterId===ids[0]),pot=b.units.find((u:any)=>u.researchProtected);if(pilot){const opts=partyOrderOptions(pilot,b,content).filter(o=>!o.disabled);const care=opts.find(o=>o.order?.kind==='skill'&&o.order.skillId===CARE),heal=opts.find(o=>o.order?.kind==='skill'&&o.order.skillId==='heal-14'),ult=opts.find(o=>o.id==='ultimate');const missingCapacity=pot.researchCapacity.originalMaxHp-pot.maxHp;const castNow=opt.policy==='early-care'?b.round%2===0:missingCapacity>=Math.ceil(pot.researchCapacity.originalMaxHp/4);if(care&&castNow&&opt.policy!=='heal-only'){b.researchCareTarget=pot.uid;b.partyOrder=care.order;careReservations++;}else if(opt.policy==='heal-only'){b.partyOrder=heal?.order??{kind:'guard'};}else if(opt.newNeri&&pilot.characterId==='neri'){const rest=opts.find(o=>o.order?.kind==='skill'&&o.order.skillId===REST);b.researchRestTarget=pot.uid;b.partyOrder=rest&&pot.researchRestRound!==b.round?rest.order:{kind:'guard'};}else{const damage=opts.find(o=>o.order?.kind==='skill'&&['attack','pierce','dawn'].includes(o.template));b.partyOrder=(low.hp<low.maxHp*.8?(ult?.order??heal?.order):enemies.length?damage?.order:{kind:'guard'})??undefined;}}
const before=b.round,after=resolveRound(b,content).battle;let observed=b.units;for(const ev of after.events){if(ev.actionSelection&&ev.skillId===CARE&&ev.unitsAfter){careCasts++;restored+=ev.unitsAfter.reduce((sum:number,u:any)=>sum+Math.max(0,u.maxHp-(observed.find((x:any)=>x.uid===u.uid)?.maxHp??u.maxHp)),0);}if(ev.unitsAfter)observed=ev.unitsAfter;}trace.push({round:before,pot:structuredClone(after.units.find((u:any)=>u.researchProtected)),enemiesAlive:after.units.filter((u:any)=>u.side==='enemy'&&u.hp>0).length,events:after.events.map((e:any)=>({text:e.text,actorId:e.actorId,targetIds:e.targetIds,amount:e.amount,capacityAfter:e.researchCapacityAfter}))});step('round',after);rounds++;}
const end=b.units.find((u:any)=>u.researchProtected);return{seed,win:b.phase==='reward',rounds,pots,fairies,flowers,careCasts,careReservations,restoredCapacity:restored,protectedHp:end.hp,protectedMaxHp:end.maxHp,protectedOriginalMaxHp:end.researchCapacity.originalMaxHp,heroesSurvived:b.units.filter((u:any)=>u.side==='party'&&!u.researchNoncombatant&&u.hp>0).length,...(opt.record?{trace,captureFixture,captureSteps,finalBattle:structuredClone(b)}:{})};}
export{content};
if(process.env.LIB_ONLY!=='1'){const configs=[{id:'elaine-main',opt:{}},{id:'elaine-heal-only',opt:{policy:'heal-only'}},{id:'elaine-old-no-care',opt:{care:false}},{id:'elaine-enemy-cleared-before-start',opt:{enemyAlreadyGone:true}},{id:'elaine-old-fio',opt:{newFio:false}},{id:'elaine-other-partners',opt:{party:['elaine','nox','athena']}},{id:'elaine-no-side-actions',opt:{sideActions:false}},{id:'elaine-early-care',opt:{policy:'early-care'}},{id:'t6-high-heal-no-elaine',opt:{party:['benzaiten','selene','athena'],tier:6}},{id:'neri-rest-no-elaine',opt:{party:['neri','fio','liora-awakened'],newNeri:true,tier:6}},{id:'awakened-elaine-no-base-care',opt:{party:['elaine-awakened','fio','liora-awakened'],tier:6}}];const cases=[];for(const c of configs){const rows=[];for(let seed=1;seed<=100;seed++)rows.push(trial(c.opt,seed));const q={...c,n:100,wins:rows.filter(x=>x.win).length,meanRounds:rows.reduce((s,x)=>s+x.rounds,0)/100,meanProtectedMaxHp:rows.reduce((s,x)=>s+x.protectedMaxHp,0)/100,rows};cases.push(q);const d=trial({...c.opt,record:true},1);writeFileSync(`${O}/${c.id}-seed1.json`,JSON.stringify({...d,configuration:c.opt,presentation:{stageName:'白花の帰還路',roundLimit:12,roundNote:'12Rまで白花の器と命を守る',phaseText:c.id.includes('no-care')||c.id.includes('heal-only')?'普通のHP手当だけの対照':'容量ケアの研究護衛',protectedUnitId:'party:research-whiteflower-pot',enemyNames:{'research-night-dew-shadow':'夜露の獣影','research-whiteflower-pot':'療養室の白花の鉢'}}},null,2));console.log(c.id,q.wins,q.meanRounds,q.meanProtectedMaxHp);}writeFileSync(`${O}/research-summary.json`,JSON.stringify({cases},null,2));trial({},1);writeFileSync(`${O}/research-lab-content.json`,JSON.stringify(content,null,2));}
