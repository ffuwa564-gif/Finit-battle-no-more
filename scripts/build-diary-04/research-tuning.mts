import{writeFileSync}from'node:fs';process.env.LIB_ONLY='1';const{trial}=await import('./research-runner.mts');const cases=[];for(const hpScale of[800,1000,1200])for(const attackScale of[260,320,380])for(const[policy,opt]of[['main',{}],['schedule',{policy:'schedule'}],['old',{newSkill:false}]]as any){const rows=[];for(let seed=1;seed<=30;seed++)rows.push(trial({...opt,hpScale,attackScale},seed));const r={hpScale,attackScale,policy,wins:rows.filter(x=>x.win).length,n:30,meanRounds:rows.reduce((s,x)=>s+x.rounds,0)/30,meanStockPaid:rows.reduce((s,x)=>s+x.stockPaid,0)/30};cases.push(r);console.log(r);}writeFileSync('artifacts/build-diary-04/research/research-tuning.json',JSON.stringify({exploratory:true,cases},null,2));
