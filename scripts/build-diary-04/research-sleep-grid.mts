import{writeFileSync}from'node:fs';process.env.LIB_ONLY='1';const{trial}=await import('./research-runner.mts');const{gem}=await import('./research-native/scripts/diary-part3/core');const party=['liora-awakened','nox','fio','noelle-awakened'],gems=[{id:'white',defId:'white-flower-seed',variant:'pure',roll:{power:80,trait:'none',value:0}},gem('echo-shard',3,'mercy',3),gem('echo-shard',3,'mercy',3),gem('pale-ward',3,'bulwark',3)];const cases=[];for(const hpScale of[800,1000])for(const attackScale of[160,180,200,220])for(const[name,opt]of[['main',{}],['old',{newSkill:false}],['no-ls',{leaderProc:false}],['auto-pilot',{policy:'auto-pilot'}]]as any){const rows=[];for(let seed=1;seed<=30;seed++)rows.push(trial({...opt,party,gems,leader:'fio',hpScale,attackScale,breakPercent:20},seed));const r={hpScale,attackScale,name,n:30,wins:rows.filter(x=>x.win).length,allAlive:rows.filter(x=>x.win&&x.survivors===4).length,rounds:rows.reduce((s,x)=>s+x.rounds,0)/30,paid:rows.reduce((s,x)=>s+x.stockPaid,0)/30,rows};cases.push(r);console.log(hpScale,attackScale,name,r.wins,r.allAlive,r.rounds,r.paid);}writeFileSync('artifacts/build-diary-04/research/research-sleep-grid.json',JSON.stringify({exploratory:true,party,leader:'fio',gems,breakPercent:20,cases},null,2));
