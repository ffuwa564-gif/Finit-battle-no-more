import{readFileSync,writeFileSync}from'node:fs';process.env.LIB_ONLY='1';const{trial,content}=await import('./research-runner.mts');const{gem}=await import('./research-native/scripts/diary-part3/core');const O='artifacts/build-diary-04/research';const base=JSON.parse(readFileSync(`${O}/final-configuration.json`,'utf8'));const configs=[{id:'selene-standard-regen-same-tier',opt:{...base,party:['liora-awakened','nox','selene-standard','noelle-awakened'],leader:'selene-standard',gems:[base.gems[0],base.gems[1],gem('echo-shard',3,'mercy',3),base.gems[3]]}},{id:'athena-no-healer-same-tier-higher-rarity',opt:{...base,party:['athena','nox','seris-awakened','noelle-awakened'],leader:'athena',gems:[base.gems[0],base.gems[1],gem('echo-shard',3,'mercy',3),base.gems[3]]}}];const cases=[];for(const c of configs){const rows=[];for(let seed=1;seed<=100;seed++)rows.push(trial(c.opt,seed));const q={...c,n:100,wins:rows.filter(x=>x.win).length,allFourSurvivedWins:rows.filter(x=>x.win&&x.survivors===4).length,meanRounds:rows.reduce((s,r)=>s+r.rounds,0)/100,meanPotions:rows.reduce((s,r)=>s+r.pots,0)/100,meanFlowers:rows.reduce((s,r)=>s+r.flowers,0)/100,meanFairies:rows.reduce((s,r)=>s+r.fairies,0)/100,roster:c.opt.party.map((id:string)=>{const x=content.characters.find((x:any)=>x.id===id)!;return{id,role:x.role,rarity:x.rarity,skillIds:x.skillIds};}),rows};cases.push(q);writeFileSync(`${O}/${c.id}-seed1.json`,JSON.stringify({...trial({...c.opt,record:true},1),configuration:c.opt,presentation:{stageName:'薬布の渡り廊下',roundLimit:12,roundNote:'R12から閉廊の全体攻撃',phaseText:'別解・同T3比較',enemyNames:{'research-cloth-breaker':'薬布を追う破砕兵','research-corridor-bell':'渡り廊下の呼び鐘'}}},null,2));console.log(c.id,q.wins,q.allFourSurvivedWins,q.meanRounds);}writeFileSync(`${O}/research-extra-alternatives.json`,JSON.stringify({passed:true,conditionsSame:true,cases,notes:['Selene-standard has actual regen-19. Elaine-awakened in the original final-sample id contains mend-pair-20, not regeneration; display it as pair-healing.','Athena no-healer team has three SSR members; same gemTier does not imply the same character acquisition cost.']},null,2));
