import{readFileSync,writeFileSync}from'node:fs';import{createHash}from'node:crypto';process.env.LIB_ONLY='1';const{configureFio}=await import('./research-runner.mts');const{trial:rukaTrial}=await import('./research-inherited-ruka.mts');const{trial:neriTrial}=await import('./research-inherited-neri.mts');const{trial:ioneTrial}=await import('./research-inherited-ione.mts');const O='artifacts/build-diary-04/research',cases:any[]=[];const configs=[{id:'old-ruka',run:rukaTrial,opt:{party:['ruka','nox','athena','fio'],tier:4,stock:false,emergencyFirst:true,releaseCapOnWound:true,stage:'research-loom-final'}},{id:'old-neri',run:neriTrial,opt:{}},{id:'legacy-ione',run:ioneTrial,opt:{}}];for(const c of configs)for(const variant of['old-fio','new-fio']){configureFio(variant==='new-fio');const rows=[];for(let seed=1;seed<=100;seed++)rows.push(c.run(c.opt,seed));const q={id:c.id+'-'+variant,variant,opt:c.opt,n:100,wins:rows.filter(x=>x.win).length,meanRounds:rows.reduce((s,x)=>s+x.rounds,0)/100,rows};cases.push(q);writeFileSync(`${O}/${q.id}-seed1.json`,JSON.stringify(c.run({...c.opt,record:true},1),null,2));console.log(q.id,q.wins,q.meanRounds);}
for(const c of[{id:'new-fio-without-ruka',run:rukaTrial,opt:{party:['seris-awakened','nox','athena','fio'],leader:'fio',tier:6,stock:false,emergencyFirst:true,releaseCapOnWound:true,stage:'research-loom-final'}},{id:'new-fio-without-neri',run:neriTrial,opt:{party:['athena','nox','liora-awakened','fio'],leader:'fio',tier:6,mode:'no-rest'}},{id:'legacy-ione-tikka-counter-new-fio',run:ioneTrial,opt:{party:['tikka','nox','liora-awakened','fio'],cleanse:true}}]){configureFio(true);const rows=[];for(let seed=1;seed<=100;seed++)rows.push(c.run(c.opt,seed));const q={id:c.id,opt:c.opt,n:100,wins:rows.filter(x=>x.win).length,meanRounds:rows.reduce((s,x)=>s+x.rounds,0)/100,rows};cases.push(q);writeFileSync(`${O}/${q.id}-seed1.json`,JSON.stringify(c.run({...c.opt,record:true},1),null,2));console.log(q.id,q.wins,q.meanRounds);}
const by=Object.fromEntries(cases.map(c=>[c.id,c]));const source=readFileSync('scripts/build-diary-04/research-rules.mts','utf8');const checks={rukaOldBaselineExact:by['old-ruka-old-fio'].wins===100&&by['old-ruka-old-fio'].meanRounds===11.63,neriOldBaselineExact:by['old-neri-old-fio'].wins===100&&by['old-neri-old-fio'].meanRounds===12,ioneOldBaselineExact:by['legacy-ione-old-fio'].wins===100&&by['legacy-ione-old-fio'].meanRounds===6.03,newFioCannotReplaceRuka:by['new-fio-without-ruka'].wins===0,newFioCannotReplaceNeri:by['new-fio-without-neri'].wins===0,ioneCounterStillExists:by['legacy-ione-tikka-counter-new-fio'].wins>0,newSkillCreatesNoWoundRestOrCorrection:!['researchWound','researchRestRound','researchDutyStreak','researchReceipt'].some(x=>source.includes(x))};writeFileSync(`${O}/research-cross-audit.json`,JSON.stringify({passed:Object.values(checks).every(Boolean),checks,cases,limits:['Old/new Fio are separate variants. A changed main-build win rate is reported, not silently inherited.','Legacy Ione has no exclusivity certificate to revoke; her candidate still has a Tikka alternative.']},null,2));if(!Object.values(checks).every(Boolean))process.exitCode=1;
