import{readFileSync,writeFileSync}from'node:fs';import{createHash}from'node:crypto';process.env.LIB_ONLY='1';const{trial,content}=await import('./research-runner.mts');const{gem}=await import('./research-native/scripts/diary-part3/core');const O='artifacts/build-diary-04/research';const grid=JSON.parse(readFileSync(`${O}/research-role-grid.json`,'utf8'));const base=grid.cases.find((c:any)=>c.hpScale===1100&&c.attackScale===200&&c.name==='main').opt;
