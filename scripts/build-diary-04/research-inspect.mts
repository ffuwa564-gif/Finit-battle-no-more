import{writeFileSync}from'node:fs';process.env.LIB_ONLY='1';const{trial}=await import('./research-runner.mts');for(const policy of['default','early-guard']){const d=trial({party:['fio','nox','ione','noelle-awakened'],hpScale:800,attackScale:240,breakPercent:20,...(policy==='default'?{}:{policy}) ,record:true},1);writeFileSync('artifacts/build-diary-04/research/inspect-'+policy+'.json',JSON.stringify(d,null,2));console.log(policy,d.win,d.rounds);for(const r of d.trace)console.log(r.round,r.party.map((u:any)=>[u.id,u.hp]),r.events.filter((e:any)=>e.actorId?.includes('research-cloth-breaker')||e.actorId==='party:fio').map((e:any)=>[e.text,e.amount,e.targetIds]));}
