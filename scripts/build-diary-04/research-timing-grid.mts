import{writeFileSync}from'node:fs';process.env.LIB_ONLY='1';const{trial}=await import('./research-runner.mts');const party=['fio','nox','ione','noelle-awakened'];const cases=[];for(const hpScale of[600,800,1000])for(const attackScale of[200,240,280])for(const[name,opt]of[['main',{}],['early-guard',{policy:'early-guard'}],['schedule',{policy:'schedule'}],['old',{newSkill:false}],['no-ls',{leaderProc:false}]]as any){const rows=[];for(let seed=1;seed<=30;seed++)rows.push(trial({...opt,party,hpScale,attackScale},seed));const r={hpScale,attackScale,name,n:30,wins:rows.filter(x=>x.win).length,rounds:rows.reduce((s,x)=>s+x.rounds,0)/30,paid:rows.reduce((s,x)=>s+x.stockPaid,0)/30,rows};cases.push(r);console.log(hpScale,attackScale,name,r.wins,r.rounds,r.paid);}writeFileSync('artifacts/build-diary-04/research/research-timing-grid.json',JSON.stringify({exploratory:true,party,cases},null,2));
