import{writeFileSync}from'node:fs';process.env.LIB_ONLY='1';const{trial}=await import('./research-runner.mts');const{gem}=await import('./research-native/scripts/diary-part3/core');const party=['liora-awakened','nox','fio','noelle-awakened'],equipment:any={'liora-awakened':{id:'white',defId:'white-flower-seed',variant:'pure',roll:{power:80,trait:'none',value:0}},nox:gem('echo-shard',3,'mercy',3),fio:gem('echo-shard',3,'mercy',3),'noelle-awakened':gem('pale-ward',3,'bulwark',3)};const cases=[];for(const hpScale of[1000,1100])for(const attackScale of[200,260])for(const[name,opt]of[['main',{}],['payoff',{payment:false}],['old',{newSkill:false}],['fio-pilot',{party:['fio','nox','liora-awakened','noelle-awakened']}],['no-ls',{leaderProc:false}]]as any){const ids=opt.party??party,options={...opt,party:ids,gems:ids.map((id:string)=>equipment[id]),leader:'fio',hpScale,attackScale,breakPercent:20};const rows=[];for(let seed=1;seed<=100;seed++)rows.push(trial(options,seed));const r={hpScale,attackScale,name,opt:options,n:100,wins:rows.filter(x=>x.win).length,allAlive:rows.filter(x=>x.win&&x.survivors===4).length,rounds:rows.reduce((s,x)=>s+x.rounds,0)/100,paid:rows.reduce((s,x)=>s+x.stockPaid,0)/100,attacks:rows.reduce((s,x)=>s+x.fioDamageActions,0)/100,fullheals:rows.reduce((s,x)=>s+x.fioFullHeals,0)/100,sleepPay:rows.reduce((s,x)=>s+x.stockPaidWhileSleeping,0)/100,rows};cases.push(r);console.log(hpScale,attackScale,name,r.wins,r.allAlive,r.rounds,r.paid,r.attacks,r.fullheals,r.sleepPay);}writeFileSync('artifacts/build-diary-04/research/research-role-grid.json',JSON.stringify({exploratory:true,equipment,cases},null,2));
