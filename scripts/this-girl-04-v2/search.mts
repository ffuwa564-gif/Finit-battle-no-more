import{createHash}from'node:crypto';import{writeFileSync,mkdirSync,readFileSync}from'node:fs';import{gzipSync}from'node:zlib';import{content,run,gem,valid,type Config}from'./policy.mts';
import{setMode,resetMode}from'./modes.mts';
const O='artifacts/this-girl-04-v2/research';mkdirSync(O+'/search',{recursive:true});const cores=[['seris-awakened','athena','benzaiten'],['seris-awakened','lisette-awakened','mireille']];const cases=cores.flatMap((core,i)=>['ivory-tower-010','kuzuha-awakening'].flatMap(stage=>[3,4,6].map(tier=>({id:`${stage}-T${tier}-F${i+1}`,core,tier,stage}))));const spec=cases[Number(process.argv[2])];if(!spec)throw Error('bad case');
const seed=(domain:string,n:number)=>createHash('sha256').update('STILLVEIL:this-girl-04-v2:'+domain+':v1:'+n).digest().readUInt32LE(0);
function cfg(id:string,leader:string,pattern:number,tactic:number,command=false,target:'priority'|'attack'='priority'):Config{const party=[id,...spec.core];const gems=party.map((char,i)=>pattern===1&&['seris-awakened','lisette-awakened'].includes(char)?null:gem(pattern===2&&i===0?'hollow-lantern':'echo-shard',spec.tier,i%2?'mercy':'bulwark',spec.tier));if(pattern===2&&gems[0])gems[0]=gem('hollow-lantern',spec.tier,'bulwark',spec.tier);return{party,leader,gems,policy:tactic===1?1:tactic===2?2:0,autoPilot:true,command,commandMode:'conditional',commandSelective:tactic===2,commandTarget:target};}
function ev(config:Config,domain:string,count:number){if(!valid(config))throw Error('Invalid config');const rows=Array.from({length:count},(_,i)=>{const r=run(config,seed(domain,i),false,spec.stage);return{seed:seed(domain,i),win:r.win,rounds:r.rounds,cappedRounds:r.win?r.rounds:120,pots:r.pots,survivors:r.survivors,issued:r.telemetry.issuedCommands,fallbacks:r.telemetry.resourceFallbacks,redirects:r.telemetry.actualRedirects??0};});return{config,rows,wins:rows.filter(r=>r.win).length,meanCappedRounds:rows.reduce((s,r)=>s+r.cappedRounds,0)/count,meanPots:rows.reduce((s,r)=>s+r.pots,0)/count,fourAliveWins:rows.filter(r=>r.win&&r.survivors===4).length,issued:rows.reduce((s,r)=>s+r.issued,0)};}
const fast=(a:any,b:any)=>b.wins-a.wins||a.meanCappedRounds-b.meanCappedRounds||a.meanPots-b.meanPots||b.fourAliveWins-a.fourAliveWins;const safe=(a:any,b:any)=>b.wins-a.wins||b.fourAliveWins-a.fourAliveWins||a.meanPots-b.meanPots||a.meanCappedRounds-b.meanCappedRounds;const frugal=(a:any,b:any)=>b.wins-a.wins||a.meanPots-b.meanPots||a.meanCappedRounds-b.meanCappedRounds;
function select(configs:Config[],commandRequired=false){const development=configs.map(c=>ev(c,'development',16));const eligible=commandRequired?development.filter(d=>d.issued>0||d.rows.some(r=>r.fallbacks>0)):development;if(!eligible.length)throw Error('No development command policy ever issued; revise before confirmation');const top:any[]=[];for(const rank of[fast,safe,frugal]){const x=[...eligible].sort(rank).find(x=>!top.some(y=>JSON.stringify(y.config)===JSON.stringify(x.config)));if(x)top.push(x);}for(const x of [...eligible].sort(fast)){if(top.length>=3)break;if(!top.some(y=>JSON.stringify(y.config)===JSON.stringify(x.config)))top.push(x);}const selection=top.map(d=>ev(d.config,'selection',32));return{candidateCount:configs.length,eligibleCount:eligible.length,development,selection,best:[...selection].sort(fast)[0],frugal:[...selection].sort(frugal)[0]};}
const commandConfigs:Config[]=[],normalConfigs:Config[]=[],leaderConfigs:Config[]=[];for(let p=0;p<3;p++)for(let t=0;t<3;t++){for(const target of['priority','attack']as const)commandConfigs.push(cfg('noelle','noelle',p,t,true,target));normalConfigs.push(cfg('noelle','noelle',p,t));for(const l of spec.core)leaderConfigs.push(cfg('noelle',l,p,t));}
setMode('before');const B=select(commandConfigs,true);setMode('after');const M=select(commandConfigs,true),N=select(normalConfigs),L=select(leaderConfigs);const alternatives=[];
for(const id of['noelle-awakened','astraea','iris','tikka','vespera','nox']){const configs:Config[]=[];for(let p=0;p<3;p++)for(let t=0;t<3;t++){for(const lead of[id,spec.core[1]])configs.push(cfg(id,lead,p,t));if(id==='noelle-awakened')for(const target of['priority','attack']as const)configs.push(cfg(id,id,p,t,true,target));}alternatives.push({id,...select(configs)});}
const alt=[...alternatives].sort((a,b)=>fast(a.best,b.best))[0];resetMode();const out={spec,B,M,N,L,alternatives,bestAlternative:alt.id,A:alt,seedPolicy:'16development seeds, diverse3x32 selection, no heldout opened',scope:'Finite budget/strategy search; no private companion commitments or future RNG observed. All legal slots/families, Research resource safeguard. B and M each independently reselect18command configurations; N9/L27, alternatives18 (awakened Noelle36) legal candidates with role-dependent spaces, not identical global budget. M excludes policies which never issued in development, N is independently optimized no-order same-leader control, L alternate-leader same-party. Awakening alternative may use its own command.'};writeFileSync(O+'/search/'+spec.id+'.json.gz',gzipSync(JSON.stringify(out)));console.log(spec.id,'M',M.best.wins,'N',N.best.wins,'L',L.best.wins,'A',alt.id,alt.best.wins,'issued',M.best.issued);
