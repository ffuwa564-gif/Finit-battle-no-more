import{readFileSync,writeFileSync}from'node:fs';import{gunzipSync}from'node:zlib';import{content,run}from'./policy.mts';import{setMode,resetMode}from'./modes.mts';
const L=JSON.parse(readFileSync('artifacts/this-girl-04/research/confirmation-lock.json','utf8'));const comparisons=[];setMode('before');
for(const spec of L.cases){const old=JSON.parse(gunzipSync(readFileSync('artifacts/this-girl-04/research/confirmation/'+spec.id+'.json.gz')).toString());for(const row of old.arms.M.rows.slice(0,6)){const r=run(spec.arms.M.config,row.seed,false,spec.stage),actual={win:r.win,rounds:r.rounds,pots:r.pots,survivors:r.survivors},expected={win:row.win,rounds:row.rounds,pots:row.pots,survivors:row.survivors};if(JSON.stringify(actual)!==JSON.stringify(expected))throw Error('Baseline changed '+JSON.stringify({case:spec.id,seed:row.seed,actual,expected}));comparisons.push({caseId:spec.id,seed:row.seed,actual,expected,passed:true});}}resetMode();writeFileSync('artifacts/this-girl-04-v2/research/baseline-equivalence.json',JSON.stringify({passed:true,comparisons,scope:'72 actual old public04 results, same native engine and historical inputs; new research ability disabled. Not proof of every possible battle.'},null,2));console.log('BASELINE72 IDENTICAL');
