export function traceCommand(events:any[]){let issued=0,fallbacks=0,applied=0,redirects=0,ordinaryNoelle=0,areaUses=0,exposureUses=0;const traces:any[]=[];for(let i=0;i<events.length;i++){const e=events[i];if(['party:noelle','party:noelle-awakened'].includes(e.actorId)&&e.commandAction==='resource-fallback'){fallbacks++;traces.push({kind:'fallback',eventId:e.id,eventIndex:i,actorId:e.actorId,recipientIds:e.targetIds,event:e});}if(['party:noelle','party:noelle-awakened'].includes(e.actorId)&&e.text.endsWith(' — 星図の号令')){issued++;traces.push({kind:'issued',eventId:e.id,eventIndex:i,event:e});}if(e.commandRedirected!==undefined){applied++;redirects+=Number(e.commandRedirected);traces.push({kind:'recipient',eventId:e.id,eventIndex:i,changed:e.commandRedirected,event:e});}if(['party:noelle','party:noelle-awakened'].includes(e.actorId)&&e.actionSelection&&!e.ultimate&&!e.text.endsWith(' — 星図の号令')){ordinaryNoelle++;areaUses+=Number(e.skillId==='area-14');exposureUses+=Number(e.text.includes('星図の露出'));traces.push({kind:'ordinary',eventId:e.id,eventIndex:i,event:e});}}return{issued,fallbacks,applied,redirects,ordinaryNoelle,areaUses,exposureUses,traces};}
