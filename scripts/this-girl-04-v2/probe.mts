import{readFileSync,writeFileSync}from'node:fs';import{gunzipSync}from'node:zlib';import{createHash}from'node:crypto';import{run}from'./policy.mts';import{setMode,resetMode}from'./modes.mts';const O='artifacts/this-girl-04-v2/research';const lock=JSON.parse(readFileSync('artifacts/this-girl-04/research/confirmation-lock.json','utf8')),out=[];for(const c of lock.cases){const modes:any={};for(const mode of['before','after']as const){setMode(mode);const rows=Array.from({length:16},(_,i)=>{const seed=createHash('sha256').update('STILLVEIL:this-girl-04-v2:development:v1:'+i).digest().readUInt32LE(0),r=run(c.arms.M.config,seed,true,c.stage);return{win:r.win,pots:r.pots,rounds:r.win?r.rounds:120,alive:r.win&&r.survivors===4,fallbacks:r.events.filter(e=>e.commandAction==='resource-fallback').length};});modes[mode]={wins:rows.filter(x=>x.win).length,pots:rows.reduce((s,r)=>s+r.pots,0)/16,R:rows.reduce((s,r)=>s+r.rounds,0)/16,alive:rows.filter(r=>r.alive).length,fallbacks:rows.reduce((s,r)=>s+r.fallbacks,0)};}out.push({case:c.id,...modes});console.log(c.id,modes);}resetMode();writeFileSync(O+'/probe.json',JSON.stringify(out,null,2));
