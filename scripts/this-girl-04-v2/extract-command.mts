import{readFileSync,writeFileSync,existsSync}from'node:fs';import{gunzipSync}from'node:zlib';import{createHash}from'node:crypto';import{traceCommand}from'./trace-command.mts';const O='artifacts/this-girl-04-v2',sha=(p:string)=>createHash('sha256').update(readFileSync(p)).digest('hex'),out:any={passed:true,scope:'Actual engine/application events and actual source frames, never a fabricated redirect or performance proof'};for(const id of['reference','noelle']){const p=JSON.parse(gunzipSync(readFileSync(O+'/proofs/'+id+'.json.gz')).toString()),t=traceCommand(p.events),mp=O+'/capture/'+id+'.json',meta=existsSync(mp)?JSON.parse(readFileSync(mp,'utf8')):null,frames=new Map(meta?.battleEvents.map(x=>[x.event.id,x.sourceFrame])??[]);const fallback=t.traces.find(x=>x.kind==='fallback'),issued=t.traces.find(x=>x.kind==='issued'),same=(e:any,f:any)=>e.eventId.split(':').slice(0,3).join(':')===f.eventId.split(':').slice(0,3).join(':');const ordinary=fallback?t.traces.find(x=>x.kind==='ordinary'&&x.eventIndex>fallback.eventIndex&&same(x,fallback)):undefined;const bind=(e:any)=>e?{...e,sourceFrame:frames.get(e.eventId)??null}:null;if(id==='noelle'&&(!fallback||!ordinary))throw Error('Actual fallback/ordinary missing');out[id]={party:p.config.party,leader:p.config.leader,config:p.config,issued:bind(issued),fallback:bind(fallback),ordinary:bind(ordinary),actualTotals:Object.fromEntries(Object.entries(t).filter(([k])=>k!=='traces')),proofSha256:sha(O+'/proofs/'+id+'.json.gz'),metadataSha256:meta?sha(mp):null,sourceSha256:meta?sha(O+'/capture/'+id+'.mov'):null};}writeFileSync(O+'/research/mechanism-noelle.json',JSON.stringify(out,null,2));console.log(JSON.stringify(out,null,2));
