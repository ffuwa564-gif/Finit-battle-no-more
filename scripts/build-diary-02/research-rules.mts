/** Isolated research proposal; not a production skill/save schema. */
export const REST='research-neri-rest-ticket';
export function labResting(b:any,u:any){return u.side==='party'&&u.researchRestRound===b.round;}
export function restStart(b:any){const out=[];for(const u of b.units.filter((u:any)=>u.side==='party'&&u.hp>0)){if(labResting(b,u)){u.researchDutyStreak=0;delete u.guardTarget;delete u.guardUntil;delete u.guardStrength;delete u.defendingUntil;out.push({kind:'buff',actorId:u.uid,targetIds:[u.uid],text:`研究：休番 — ${u.characterId}は前線を離れて休息（このRの全手番を失う）`});}else if(u.researchRestRound===b.round-1)out.push({kind:'buff',actorId:u.uid,targetIds:[u.uid],text:`研究：復帰 — ${u.characterId}が当番へ戻った`});}return out;}
export function restSkill(b:any,u:any,id:string){if(id!==REST||u.side!=='party'||u.hp<=0)return;if(!b.researchRestTarget)return{handled:true,amount:0,targetIds:[],messages:['研究：休番の宛先がなく不発']};const t=b.units.find((x:any)=>x.uid===b.researchRestTarget&&x.side==='party'&&x.hp>0);if(!t||labResting(b,t)||t.researchRestRound===b.round+1)return{handled:true,amount:0,targetIds:[],messages:['研究：休番の宛先が不適切']};t.researchRestRound=b.round+1;return{handled:true,amount:0,targetIds:[t.uid],messages:[`研究：休番の札 — ${t.characterId}はR${b.round+1}に休み、R${b.round+2}に復帰`]};}
export function restFinish(b:any){const q=b.researchDutyRules;if(!q)return[];const out=[];for(const u of b.units.filter((u:any)=>u.side==='party'&&u.hp>0)){if(!labResting(b,u))u.researchDutyStreak=(u.researchDutyStreak??0)+1;if(u.researchDutyStreak>=q.maxStreak){u.hp=0;delete u.ailments;delete u.statusWardUntil;out.push({kind:'defeat',actorId:u.uid,targetIds:[u.uid],text:`研究：当番${u.researchDutyStreak}R連続 — ${u.characterId}は過労で離脱（HP被害ではない）`});}else out.push({kind:'buff',actorId:u.uid,targetIds:[u.uid],text:`研究：当番の記録 — ${u.characterId} ${u.researchDutyStreak??0}/${q.maxStreak-1}R`});}if(b.round>=q.finishRound&&b.units.filter((u:any)=>u.side==='party'&&u.hp>0).length<q.minimumSurvivors){q.objectiveFailed=true;out.push({kind:'defeat',text:'研究：渡し舟の護衛失敗 — 帰還する仲間は3人以上必要'});}else if(b.round>=q.finishRound){for(const e of b.units.filter((u:any)=>u.side==='enemy'))e.hp=0;out.push({kind:'wave',text:'研究：朝の渡し舟が到着 — 12Rの護衛任務を達成（敵の撃破ではない）'});}return out;}
