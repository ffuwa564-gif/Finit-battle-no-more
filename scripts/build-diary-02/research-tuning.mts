import{writeFileSync}from'node:fs';process.env.LIB_ONLY='1';const{trial}=await import('./research-runner.mts');const cases=[];for(const attack of[260,320,400,480])for(const[mode,opt]of[['main',{}],['reverse',{plan:['fio','elaine-awakened','nox','neri',null]}],['single-healer',{party:['neri','nox','liora-awakened','fio']}],['no-side',{sideActions:false}] ]as any){const rows=[];for(let seed=1;seed<=100;seed++)rows.push(trial({...opt,enemyAttack:attack},seed));const r={attack,mode,wins:rows.filter(x=>x.win).length,meanSurvivors:rows.reduce((s,r)=>s+r.survivors,0)/100};cases.push(r);console.log(r);}writeFileSync('artifacts/build-diary-02/research/research-tuning.json',JSON.stringify({cases},null,2));
