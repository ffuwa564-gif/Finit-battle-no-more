  "voices": [
    {
      "lagMs": 0.0,
      "correlation": 0.999992,
      "id": "z001",
      "text": "ずんだもんなのだ。今日は、このゲームを遊ぶのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999955,
      "id": "z002",
      "text": "この子が案内役なんだね。よろしくなのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.9999,
      "id": "z003",
      "text": "ガチャも気になるけど、先に冒険してみよう。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999954,
      "id": "z004",
      "text": "名前は、ずん。よし、出発なのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999981,
      "id": "z005",
      "text": "最初の仕事は、狼退治。いよいよ冒険なのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999885,
      "id": "z006",
      "text": "拾ったものを、工房で使えるんだ。これは持って帰りたいのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999918,
      "id": "z007",
      "text": "お、行き先が出てる。聖堂へ向かうのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999874,
      "id": "z008",
      "text": "出発すると全回復。まずは、この四人で行ってみよう。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999921,
      "id": "z009",
      "text": "よし、初戦なのだ。どんな技を使うか見てみよう。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999736,
      "id": "z010",
      "text": "味方の吹き出しが出てる。みんな、自分で選ぶんだね。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999946,
      "id": "z045",
      "text": "リオラに攻撃が集まってるのだ。盾の子、頼んだのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999951,
      "id": "z011",
      "text": "エレインが回復役か。リオラの盾と合わせて、粘ってほしいのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999331,
      "id": "z012",
      "text": "次の一手。そろそろ、この敵を倒したいのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999974,
      "id": "z053",
      "text": "リオラの体力が戻った。よし、まだ進めるのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999954,
      "id": "z013",
      "text": "攻撃する子と、支える子。四人の仕事が違うんだね。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.99994,
      "id": "z046",
      "text": "後ろの三人は元気なのだ。回復役がいると、ちょっと安心するね。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999688,
      "id": "z014",
      "text": "あと少しだといいな。拾った素材を、ちゃんと持って帰りたいのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999804,
      "id": "z054",
      "text": "リオラ、まだ立てるのだ。他の三人も元気だし、頼んだよ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999531,
      "id": "z015",
      "text": "よし、勝ったのだ。忘れずに、戦利品を確定するのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999965,
      "id": "z016",
      "text": "初仕事、完了なのだ。リオラに報告しよう。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999954,
      "id": "z017",
      "text": "おお、きれい。さっき戦ってた場所も、この街の一部なのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999853,
      "id": "z018",
      "text": "次の仕事、ある？　もう一回、探索してみたいのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.99994,
      "id": "z019",
      "text": "次は参道の巡回。資材も、もう少し集めてこよう。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999854,
      "id": "z020",
      "text": "二回目なのだ。さっきの四人で、このまま行ってみよう。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999933,
      "id": "z021",
      "text": "今度は、どんな相手かな。まずは、一巡なのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999949,
      "id": "z047",
      "text": "一回クリアすると、次の探索にも行きたくなるのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999908,
      "id": "z022",
      "text": "さっきの傷は持ち越さない。遠慮せず、進めるのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999922,
      "id": "z055",
      "text": "少しずつ削られてるけど、まだ余裕はありそうなのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999639,
      "id": "z023",
      "text": "全員の動きがつながると、見てて気持ちいいのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999714,
      "id": "z024",
      "text": "これはいけそうなのだ。このまま、持ち帰るところまで。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999692,
      "id": "z048",
      "text": "みんな少し削られたけど、まだ大丈夫そうなのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999509,
      "id": "z025",
      "text": "二つ目も踏破！　これ、つい次へ行きたくなるのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999923,
      "id": "z026",
      "text": "あと二つで、もう一周。周回する理由が、切実なのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999968,
      "id": "z027",
      "text": "推しに会う前に、ボクたちは鐘楼へ。寄り道は、また今度なのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999948,
      "id": "z028",
      "text": "三つ目は、鐘楼の調査。今度は、鐘のことを調べるのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.99992,
      "id": "z029",
      "text": "ここも全回復。ちゃんと帰って、工房まで触りたいのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999952,
      "id": "z030",
      "text": "三回目。だいぶ、操作にも慣れてきたのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999969,
      "id": "z031",
      "text": "まずは目の前から。次の敵へ急ぎすぎないようにしよう。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999965,
      "id": "z056",
      "text": "この四人、見た目よりずっと粘るのだ。誰も倒れてないね。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999646,
      "id": "z032",
      "text": "味方に任せるところは任せて、ラウンドを進めるのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999899,
      "id": "z049",
      "text": "鐘の調査って、もう少し平和な仕事だと思ってたのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999822,
      "id": "z033",
      "text": "鐘楼の奥まで来たのだ。ここを抜けたら、ノエルに話を聞こう。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999844,
      "id": "z050",
      "text": "ノエルもちょっと削られてる。ちゃんと、みんなで帰るのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999869,
      "id": "z034",
      "text": "まだ倒れないのだ。こっちも崩れてないし、押し切ろう。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999629,
      "id": "z051",
      "text": "この相手、けっこう粘るのだ。こっちも、しぶとく行こう。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999786,
      "id": "z035",
      "text": "鐘楼も踏破なのだ。これで、三か所回れたね。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999816,
      "id": "z052",
      "text": "お、レア素材もあるのだ。この周回は、ちょっと得したね。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999935,
      "id": "z036",
      "text": "え、今、そこで生まれたの？",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999884,
      "id": "z037",
      "text": "三人で帰っていくんだ。でも、最初の扉は、あれだったからなあ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999932,
      "id": "z038",
      "text": "鐘の調査の続きかな。ノエルの話を聞いてみよう。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.9999,
      "id": "z039",
      "text": "え、調査隊が帰ってないの？　急に、ただの巡回じゃなくなったのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999884,
      "id": "z040",
      "text": "調査に備えて、工房も触ってみよう。まずは作業台なのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999908,
      "id": "z041",
      "text": "加工中。待ち時間だけ、二倍速なのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999834,
      "id": "z042",
      "text": "作業台、設置できたのだ。これで、持ち帰る楽しみも増えたね。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999793,
      "id": "z043",
      "text": "今日は三つの探索と、初めての工房。ちゃんと冒険したのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999845,
      "id": "z044",
      "text": "調査隊のことも気になるし、続きも、また遊んでみよう。",
      "pass": true
    }
