  "voices": [
    {
      "lagMs": 0.0,
      "correlation": 0.999985,
      "id": "z01",
      "text": "今日は、オート戦闘でのんびり素材集めをするのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999837,
      "id": "z02",
      "text": "前回の四人で、忘却の聖堂へもう一周。勝てる場所なら、余裕なのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.99991,
      "id": "z03",
      "text": "石と鉱石を持ち帰りたいのだ。ついでに原石も、ちょっとだけ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999945,
      "id": "z04",
      "text": "ぽちっとオート。これで、ぼくは拾う係なのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999769,
      "id": "z05",
      "text": "三択なのだ。まずは指先。連打を少なくする作戦でいくのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.997254,
      "id": "z08",
      "text": "あっ、落ちた。こっちを拾って、次はあっちなのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999573,
      "id": "z09",
      "text": "石も拾えたのだ。まだまだ、このくらい余裕なのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999809,
      "id": "z10",
      "text": "原石も取れた！ 素材だけのつもりが、ちょっと欲が出てきたのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999784,
      "id": "z06",
      "text": "また指先がある！ 楽をするための投資なのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.998776,
      "id": "z11",
      "text": "あれ？ 三つも逃してる。原石ばかり見ていたのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999897,
      "id": "z13",
      "text": "みんな、戦闘は任せたのだ。ぼくは現場の回収係なのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999861,
      "id": "z12",
      "text": "十個回収！ もう、ぼくが戦っているのか、拾っているのかわからないのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999343,
      "id": "z07",
      "text": "三枚とも指先なのだ。キャラより、ぼくの指が育っているのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999476,
      "id": "z14",
      "text": "回復も落ちているのだ。拾い物だけで、けっこう助かっているのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999632,
      "id": "z15",
      "text": "画面の左も右も気になるのだ。目がもう一組ほしいのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999661,
      "id": "z16",
      "text": "よし、倒したのだ！ でも、まだ安心してはいけないのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999832,
      "id": "z17",
      "text": "拾えたのは18個。逃したのは7個。全部は取れなかったのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999923,
      "id": "z18",
      "text": "獲得を確定。これでようやく、ぼくのものなのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999783,
      "id": "z19",
      "text": "のんびりする予定が、ずっと拾っていたのだ。オートとは何だったのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999875,
      "id": "z20",
      "text": "次は素材を増やす組み合わせも試したいのだ。あと一周だけ。ほんとに、一周だけなのだ。",
      "pass": true
    }
  ],
