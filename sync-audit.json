  "voices": [
    {
      "lagMs": 0.0,
      "correlation": 0.999992,
      "id": "z001",
      "text": "ずんだもんの、勲章コンプ日記。第一回、めざすのだ！",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999984,
      "id": "z002",
      "text": "ボクはずんだもん。今日は、勲章を集める冒険を始めるのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999786,
      "id": "z003",
      "text": "まずは図鑑。どんな勲章があるのかな。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999881,
      "id": "z004",
      "text": "えっ、百種類あるの？　思ったより長い旅になりそうなのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999925,
      "id": "z005",
      "text": "工房だけじゃなくて、探索も、仲間もあるんだね。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999827,
      "id": "z006",
      "text": "初めての踏破。うん、まずはこれからなのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999898,
      "id": "z007",
      "text": "一個も取れてない今なら、何をしても前進なのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.99971,
      "id": "z008",
      "text": "名前は、ずん。最初からいる四人で行ってみるのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999849,
      "id": "z009",
      "text": "最初のお仕事は、狼退治なのだ。よろしく頼むのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999917,
      "id": "z010",
      "text": "権利の照会って何？　初仕事から話が重いのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999911,
      "id": "z011",
      "text": "まずは聖堂。勲章第一号を取りに行くのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999889,
      "id": "z012",
      "text": "全員で帰れたらいいな。回復薬は、必要になったら使うのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999818,
      "id": "z013",
      "text": "よし、初戦。みんなの選択を見て、一手をつなぐのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999671,
      "id": "z014",
      "text": "最初の一巡。みんな、どう動くかな。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.99996,
      "id": "z039",
      "text": "リオラが攻撃を受けてるのだ。後ろの三人、今のうちに頼むのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.99989,
      "id": "z015",
      "text": "四人とも仕事が違うのだ。ボクだけ突っ走らないようにしよう。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999861,
      "id": "z016",
      "text": "素材が落ちても、まだ確定じゃない。ちゃんと帰るのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999931,
      "id": "z017",
      "text": "一個目の勲章のために、こんなに真剣になるとは。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999892,
      "id": "z040",
      "text": "盾の子に攻撃が集まるね。回復も、うまくつながってほしいのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999323,
      "id": "z018",
      "text": "最初の探索から、けっこう粘るのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999601,
      "id": "z041",
      "text": "減ってはいるけど、まだ立ってる。全員で帰るまで、もうひと踏ん張り。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999792,
      "id": "z019",
      "text": "ここで欲張って、全滅だけは嫌なのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999147,
      "id": "z020",
      "text": "よし、クリアなのだ！　まずは素材を持ち帰ろう。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999835,
      "id": "z021",
      "text": "えっ、一回で7個も取れたの？　まとめ取りなのだ！",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999936,
      "id": "z022",
      "text": "景色がきれいなのだ。でもボクは、さっきの勲章が気になってる。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999944,
      "id": "z023",
      "text": "次の仕事もあるの？　じゃあ、もう一か所なのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999917,
      "id": "z024",
      "text": "次は参道なのだ。違う場所も、ひとつずつ埋めていこう。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999887,
      "id": "z025",
      "text": "出発すれば全回復。さっきの四人で続けるのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999937,
      "id": "z026",
      "text": "二回目。今度は、ちょっと落ち着いて見られるのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999915,
      "id": "z027",
      "text": "さっきと同じ編成で行くのだ。回復役、頼りにしてるのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999831,
      "id": "z042",
      "text": "少しずつ減ってきたのだ。ここは、このまま進めてみるのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999507,
      "id": "z028",
      "text": "敵を倒すだけじゃなくて、全員で帰りたいのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999843,
      "id": "z043",
      "text": "勲章を集める旅だけど、目の前の一戦を大事にするのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999829,
      "id": "z029",
      "text": "この調子で埋まったらいいけど、後半は絶対そうはいかないのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999693,
      "id": "z030",
      "text": "二か所目も踏破！　今日は、ここで記録を見てみるのだ。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999956,
      "id": "z031",
      "text": "あれ、勲章は増えてないのだ。同じ条件だけじゃ、もう取れないんだね。",
      "pass": true
    },
    {
      "lagMs": 0.0,
      "correlation": 0.999919,
      "id": "z032",
      "text": "今日の成果は、百種類中、7個なのだ！",
