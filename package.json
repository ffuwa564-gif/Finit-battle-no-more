{
  "name": "stillveil-rpg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests",
    "check:content": "tsx scripts/check-content.ts",
    "check:ui": "tsx scripts/check-ui.ts",
    "check:release": "tsx scripts/check-approvals.ts",
    "build": "npm run typecheck && npm run check:content && npm run check:ui && vite build && tsx scripts/stamp-build.ts",
    "package:release": "node scripts/release.mjs",
    "release": "npm run test && npm run build && npm run check:release && npm run package:release",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e": "playwright test",
    "balance:events": "tsx scripts/balance-events.ts"
  },
  "dependencies": {
    "gsap": "^3.14.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^3.2.0"
  }
}
